	rg1616 = 0x32334752, // [31:0] R:G 16:16 little endian
	gr1616 = 0x32335247, // [31:0] G:R 16:16 little endian
	xrgb16161616f = 0x48345258, // [63:0] x:R:G:B 16:16:16:16 little endian
	xbgr16161616f = 0x48344258, // [63:0] x:B:G:R 16:16:16:16 little endian
	argb16161616f = 0x48345241, // [63:0] A:R:G:B 16:16:16:16 little endian
	abgr16161616f = 0x48344241, // [63:0] A:B:G:R 16:16:16:16 little endian
	xyuv8888 = 0x56555958, // [31:0] X:Y:Cb:Cr 8:8:8:8 little endian
	vuy888 = 0x34325556, // [23:0] Cr:Cb:Y 8:8:8 little endian
	vuy101010 = 0x30335556, // Y followed by U then V, 10:10:10. Non-linear modifier only
	y210 = 0x30313259, // [63:0] Cr0:0:Y1:0:Cb0:0:Y0:0 10:6:10:6:10:6:10:6 little endian per 2 Y pixels
	y212 = 0x32313259, // [63:0] Cr0:0:Y1:0:Cb0:0:Y0:0 12:4:12:4:12:4:12:4 little endian per 2 Y pixels
	y216 = 0x36313259, // [63:0] Cr0:Y1:Cb0:Y0 16:16:16:16 little endian per 2 Y pixels
	y410 = 0x30313459, // [31:0] A:Cr:Y:Cb 2:10:10:10 little endian
	y412 = 0x32313459, // [63:0] A:0:Cr:0:Y:0:Cb:0 12:4:12:4:12:4:12:4 little endian
	y416 = 0x36313459, // [63:0] A:Cr:Y:Cb 16:16:16:16 little endian
	xvyu2101010 = 0x30335658, // [31:0] X:Cr:Y:Cb 2:10:10:10 little endian
	xvyu12_16161616 = 0x36335658, // [63:0] X:0:Cr:0:Y:0:Cb:0 12:4:12:4:12:4:12:4 little endian
	xvyu16161616 = 0x38345658, // [63:0] X:Cr:Y:Cb 16:16:16:16 little endian
	y0l0 = 0x304c3059, // [63:0]   A3:A2:Y3:0:Cr0:0:Y2:0:A1:A0:Y1:0:Cb0:0:Y0:0  1:1:8:2:8:2:8:2:1:1:8:2:8:2:8:2 little endian
	x0l0 = 0x304c3058, // [63:0]   X3:X2:Y3:0:Cr0:0:Y2:0:X1:X0:Y1:0:Cb0:0:Y0:0  1:1:8:2:8:2:8:2:1:1:8:2:8:2:8:2 little endian
	y0l2 = 0x324c3059, // [63:0]   A3:A2:Y3:Cr0:Y2:A1:A0:Y1:Cb0:Y0  1:1:10:10:10:1:1:10:10:10 little endian
	x0l2 = 0x324c3058, // [63:0]   X3:X2:Y3:Cr0:Y2:X1:X0:Y1:Cb0:Y0  1:1:10:10:10:1:1:10:10:10 little endian
	yuv420_8bit = 0x38305559,
	yuv420_10bit = 0x30315559,
	xrgb8888_a8 = 0x38415258,
	xbgr8888_a8 = 0x38414258,
	rgbx8888_a8 = 0x38415852,
	bgrx8888_a8 = 0x38415842,
	rgb888_a8 = 0x38413852,
	bgr888_a8 = 0x38413842,
	rgb565_a8 = 0x38413552,
	bgr565_a8 = 0x38413542,
	nv24 = 0x3432564e, // non-subsampled Cr:Cb plane
	nv42 = 0x3234564e, // non-subsampled Cb:Cr plane
	p210 = 0x30313250, // 2x1 subsampled Cr:Cb plane, 10 bit per channel
	p010 = 0x30313050, // 2x2 subsampled Cr:Cb plane 10 bits per channel
	p012 = 0x32313050, // 2x2 subsampled Cr:Cb plane 12 bits per channel
	p016 = 0x36313050, // 2x2 subsampled Cr:Cb plane 16 bits per channel
	axbxgxrx106106106106 = 0x30314241, // [63:0] A:x:B:x:G:x:R:x 10:6:10:6:10:6:10:6 little endian
	nv15 = 0x3531564e, // 2x2 subsampled Cr:Cb plane
	q410 = 0x30313451,
	q401 = 0x31303451,
	xrgb16161616 = 0x38345258, // [63:0] x:R:G:B 16:16:16:16 little endian
	xbgr16161616 = 0x38344258, // [63:0] x:B:G:R 16:16:16:16 little endian
	argb16161616 = 0x38345241, // [63:0] A:R:G:B 16:16:16:16 little endian
	abgr16161616 = 0x38344241, // [63:0] A:B:G:R 16:16:16:16 little endian
	c1 = 0x20203143, // [7:0] C0:C1:C2:C3:C4:C5:C6:C7 1:1:1:1:1:1:1:1 eight pixels/byte
	c2 = 0x20203243, // [7:0] C0:C1:C2:C3 2:2:2:2 four pixels/byte
	c4 = 0x20203443, // [7:0] C0:C1 4:4 two pixels/byte
	d1 = 0x20203144, // [7:0] D0:D1:D2:D3:D4:D5:D6:D7 1:1:1:1:1:1:1:1 eight pixels/byte
	d2 = 0x20203244, // [7:0] D0:D1:D2:D3 2:2:2:2 four pixels/byte
	d4 = 0x20203444, // [7:0] D0:D1 4:4 two pixels/byte
	d8 = 0x20203844, // [7:0] D
	r1 = 0x20203152, // [7:0] R0:R1:R2:R3:R4:R5:R6:R7 1:1:1:1:1:1:1:1 eight pixels/byte
	r2 = 0x20203252, // [7:0] R0:R1:R2:R3 2:2:2:2 four pixels/byte
	r4 = 0x20203452, // [7:0] R0:R1 4:4 two pixels/byte
	r10 = 0x20303152, // [15:0] x:R 6:10 little endian
	r12 = 0x20323152, // [15:0] x:R 4:12 little endian
	avuy8888 = 0x59555641, // [31:0] A:Cr:Cb:Y 8:8:8:8 little endian
	xvuy8888 = 0x59555658, // [31:0] X:Cr:Cb:Y 8:8:8:8 little endian
	p030 = 0x30333050, // 2x2 subsampled Cr:Cb plane 10 bits per channel packed
	rgb161616 = 0x38344752, // [47:0] R:G:B 16:16:16 little endian
	bgr161616 = 0x38344742, // [47:0] B:G:R 16:16:16 little endian
	r16f = 0x48202052, // [15:0] R 16 little endian
	gr1616f = 0x48205247, // [31:0] G:R 16:16 little endian
	bgr161616f = 0x48524742, // [47:0] B:G:R 16:16:16 little endian
	r32f = 0x46202052, // [31:0] R 32 little endian
	gr3232f = 0x46205247, // [63:0] G:R 32:32 little endian
	bgr323232f = 0x46524742, // [95:0] B:G:R 32:32:32 little endian
	abgr32323232f = 0x46384241, // [127:0] A:B:G:R 32:32:32:32 little endian
	nv20 = 0x3032564e, // 2x1 subsampled Cr:Cb plane
	nv30 = 0x3033564e, // non-subsampled Cr:Cb plane
	s010 = 0x30313053, // 2x2 subsampled Cb (1) and Cr (2) planes 10 bits per channel
	s210 = 0x30313253, // 2x1 subsampled Cb (1) and Cr (2) planes 10 bits per channel
	s410 = 0x30313453, // non-subsampled Cb (1) and Cr (2) planes 10 bits per channel
	s012 = 0x32313053, // 2x2 subsampled Cb (1) and Cr (2) planes 12 bits per channel
	s212 = 0x32313253, // 2x1 subsampled Cb (1) and Cr (2) planes 12 bits per channel
	s412 = 0x32313453, // non-subsampled Cb (1) and Cr (2) planes 12 bits per channel
	s016 = 0x36313053, // 2x2 subsampled Cb (1) and Cr (2) planes 16 bits per channel
	s216 = 0x36313253, // 2x1 subsampled Cb (1) and Cr (2) planes 16 bits per channel
	s416 = 0x36313453, // non-subsampled Cb (1) and Cr (2) planes 16 bits per channel
	xvuy2101010 = 0x30335958, // [31:0] x:Cr:Cb:Y 2:10:10:10 little endian
	p230 = 0x30333250, // 2x1 subsampled Cr:Cb plane 10 bits per channel packed
	t430 = 0x30333454,
	y8 = 0x59455247, // 8-bit Y-only
	xyyy2101010 = 0x34415059, // [31:0] x:Y2:Y1:Y0 2:10:10:10 little endian
}

Wl_Shm_Request :: enum u16 {
	create_pool = 0,
	release = 1,
}

Wl_Shm_Event :: enum u16 {
	format = 0,
}

// server-side request handlers
Wl_Shm_Requests :: struct {
	// create a shm pool
	create_pool: proc(obj: ^Object, id: ^Object, fd: linux.Fd, size: i32),
	// release the shm object
	release: proc(obj: ^Object),
}

// client-side event handlers
Wl_Shm_Events :: struct {
	// pixel format description
	format: proc(obj: ^Object, format: u32),
}

@(private)
_wl_shm_dispatch_request :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Shm_Requests)(obj.handlers)
	switch opcode {
	case 0: // create_pool
		a_id := read_new_id(r, &wl_shm_pool_interface, obj.version)
		a_fd := read_fd(r)
		a_size := read_int(r)
		if !r.ok { return false }
		if h != nil && h.create_pool != nil {
			h.create_pool(obj, a_id, a_fd, a_size)
		} else {
			linux.close(a_fd)
		}
	case 1: // release
		if !r.ok { return false }
		if h != nil && h.release != nil {
			h.release(obj)
		}
		object_destroy(obj)
	case:
		return false
	}
	return true
}

@(private)
_wl_shm_dispatch_event :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Shm_Events)(obj.handlers)
	switch opcode {
	case 0: // format
		a_format := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.format != nil {
			h.format(obj, a_format)
		}
	case:
		return false
	}
	return true
}

// pixel format description
wl_shm_send_format :: proc(obj: ^Object, format: u32) {
	w := begin_message(obj, 0)
	write_uint(&w, format)
	end_message(&w)
}

// create a shm pool
wl_shm_create_pool :: proc(obj: ^Object, fd: linux.Fd, size: i32) -> ^Object {
	id := object_create(obj.conn, &wl_shm_pool_interface, obj.version)
	w := begin_message(obj, 0)
	write_object(&w, id)
	write_fd(&w, fd)
	write_int(&w, size)
	end_message(&w)
	return id
}

// release the shm object
wl_shm_release :: proc(obj: ^Object) {
	if obj.version < 2 { return }
	w := begin_message(obj, 1)
	end_message(&w)
	object_destroy(obj)
}

// ===== wl_buffer (version 1) =====
// content for a wl_surface

wl_buffer_interface := Interface{
	name = "wl_buffer",
	version = 1,
	requests = {
		{name = "destroy", signature = "", since = 1, fd_count = 0, destructor = true},
	},
	events = {
		{name = "release", signature = "", since = 1, fd_count = 0, destructor = false},
	},
	dispatch_request = _wl_buffer_dispatch_request,
	dispatch_event = _wl_buffer_dispatch_event,
}

Wl_Buffer_Request :: enum u16 {
	destroy = 0,
}

Wl_Buffer_Event :: enum u16 {
	release = 0,
}

// server-side request handlers
Wl_Buffer_Requests :: struct {
	// destroy a buffer
	destroy: proc(obj: ^Object),
}

// client-side event handlers
Wl_Buffer_Events :: struct {
	// compositor releases buffer
	release: proc(obj: ^Object),
}

@(private)
_wl_buffer_dispatch_request :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Buffer_Requests)(obj.handlers)
	switch opcode {
	case 0: // destroy
		if !r.ok { return false }
		if h != nil && h.destroy != nil {
			h.destroy(obj)
		}
		object_destroy(obj)
	case:
		return false
	}
	return true
}

@(private)
_wl_buffer_dispatch_event :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Buffer_Events)(obj.handlers)
	switch opcode {
	case 0: // release
		if !r.ok { return false }
		if h != nil && h.release != nil {
			h.release(obj)
		}
	case:
		return false
	}
	return true
}

// compositor releases buffer
wl_buffer_send_release :: proc(obj: ^Object) {
	w := begin_message(obj, 0)
	end_message(&w)
}

// destroy a buffer
wl_buffer_destroy :: proc(obj: ^Object) {
	w := begin_message(obj, 0)
	end_message(&w)
	object_destroy(obj)
}

// ===== wl_data_offer (version 4) =====
// offer to transfer data

wl_data_offer_interface := Interface{
	name = "wl_data_offer",
	version = 4,
	requests = {
		{name = "accept", signature = "u?s", since = 1, fd_count = 0, destructor = false},
		{name = "receive", signature = "sh", since = 1, fd_count = 1, destructor = false},
		{name = "destroy", signature = "", since = 1, fd_count = 0, destructor = true},
		{name = "finish", signature = "", since = 3, fd_count = 0, destructor = false},
		{name = "set_actions", signature = "uu", since = 3, fd_count = 0, destructor = false},
	},
	events = {
		{name = "offer", signature = "s", since = 1, fd_count = 0, destructor = false},
		{name = "source_actions", signature = "u", since = 3, fd_count = 0, destructor = false},
		{name = "action", signature = "u", since = 3, fd_count = 0, destructor = false},
	},
	dispatch_request = _wl_data_offer_dispatch_request,
	dispatch_event = _wl_data_offer_dispatch_event,
}

Wl_Data_Offer_Error :: enum u32 {
	invalid_finish = 0, // finish request was called untimely
	invalid_action_mask = 1, // action mask contains invalid values
	invalid_action = 2, // action argument has an invalid value
	invalid_offer = 3, // offer doesn't accept this request
}

Wl_Data_Offer_Request :: enum u16 {
	accept = 0,
	receive = 1,
	destroy = 2,
	finish = 3,
	set_actions = 4,
}

Wl_Data_Offer_Event :: enum u16 {
	offer = 0,
	source_actions = 1,
	action = 2,
}

// server-side request handlers
Wl_Data_Offer_Requests :: struct {
	// accept one of the offered mime types
	accept: proc(obj: ^Object, serial: u32, mime_type: string),
	// request that the data is transferred
	receive: proc(obj: ^Object, mime_type: string, fd: linux.Fd),
	// destroy data offer
	destroy: proc(obj: ^Object),
	// the offer will no longer be used
	finish: proc(obj: ^Object),
	// set the available/preferred drag-and-drop actions
	set_actions: proc(obj: ^Object, dnd_actions: u32, preferred_action: u32),
}

// client-side event handlers
Wl_Data_Offer_Events :: struct {
	// advertise offered mime type
	offer: proc(obj: ^Object, mime_type: string),
	// notify the source-side available actions
	source_actions: proc(obj: ^Object, source_actions: u32),
	// notify the selected action
	action: proc(obj: ^Object, dnd_action: u32),
}

@(private)
_wl_data_offer_dispatch_request :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Data_Offer_Requests)(obj.handlers)
	switch opcode {
	case 0: // accept
		a_serial := read_uint(r)
		a_mime_type := read_string(r, true)
		if !r.ok { return false }
		if h != nil && h.accept != nil {
			h.accept(obj, a_serial, a_mime_type)
		}
	case 1: // receive
		a_mime_type := read_string(r, false)
		a_fd := read_fd(r)
		if !r.ok { return false }
		if h != nil && h.receive != nil {
			h.receive(obj, a_mime_type, a_fd)
		} else {
			linux.close(a_fd)
		}
	case 2: // destroy
		if !r.ok { return false }
		if h != nil && h.destroy != nil {
			h.destroy(obj)
		}
		object_destroy(obj)
	case 3: // finish
		if !r.ok { return false }
		if h != nil && h.finish != nil {
			h.finish(obj)
		}
	case 4: // set_actions
		a_dnd_actions := read_uint(r)
		a_preferred_action := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.set_actions != nil {
			h.set_actions(obj, a_dnd_actions, a_preferred_action)
		}
	case:
		return false
	}
	return true
}

@(private)
_wl_data_offer_dispatch_event :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Data_Offer_Events)(obj.handlers)
	switch opcode {
	case 0: // offer
		a_mime_type := read_string(r, false)
		if !r.ok { return false }
		if h != nil && h.offer != nil {
			h.offer(obj, a_mime_type)
		}
	case 1: // source_actions
		a_source_actions := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.source_actions != nil {
			h.source_actions(obj, a_source_actions)
		}
	case 2: // action
		a_dnd_action := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.action != nil {
			h.action(obj, a_dnd_action)
		}
	case:
		return false
	}
	return true
}

// advertise offered mime type
wl_data_offer_send_offer :: proc(obj: ^Object, mime_type: string) {
	w := begin_message(obj, 0)
	write_string(&w, mime_type, false)
	end_message(&w)
}

// notify the source-side available actions
wl_data_offer_send_source_actions :: proc(obj: ^Object, source_actions: u32) {
	if obj.version < 3 { return }
	w := begin_message(obj, 1)
	write_uint(&w, source_actions)
	end_message(&w)
}

// notify the selected action
wl_data_offer_send_action :: proc(obj: ^Object, dnd_action: u32) {
	if obj.version < 3 { return }
	w := begin_message(obj, 2)
	write_uint(&w, dnd_action)
	end_message(&w)
}

// accept one of the offered mime types
wl_data_offer_accept :: proc(obj: ^Object, serial: u32, mime_type: string) {
	w := begin_message(obj, 0)
	write_uint(&w, serial)
	write_string(&w, mime_type, true)
	end_message(&w)
}

// request that the data is transferred
wl_data_offer_receive :: proc(obj: ^Object, mime_type: string, fd: linux.Fd) {
	w := begin_message(obj, 1)
	write_string(&w, mime_type, false)
	write_fd(&w, fd)
	end_message(&w)
}

// destroy data offer
wl_data_offer_destroy :: proc(obj: ^Object) {
	w := begin_message(obj, 2)
	end_message(&w)
	object_destroy(obj)
}

// the offer will no longer be used
wl_data_offer_finish :: proc(obj: ^Object) {
	if obj.version < 3 { return }
	w := begin_message(obj, 3)
	end_message(&w)
}

// set the available/preferred drag-and-drop actions
wl_data_offer_set_actions :: proc(obj: ^Object, dnd_actions: u32, preferred_action: u32) {
	if obj.version < 3 { return }
	w := begin_message(obj, 4)
	write_uint(&w, dnd_actions)
	write_uint(&w, preferred_action)
	end_message(&w)
}

// ===== wl_data_source (version 4) =====
// offer to transfer data

wl_data_source_interface := Interface{
	name = "wl_data_source",
	version = 4,
	requests = {
		{name = "offer", signature = "s", since = 1, fd_count = 0, destructor = false},
		{name = "destroy", signature = "", since = 1, fd_count = 0, destructor = true},
		{name = "set_actions", signature = "u", since = 3, fd_count = 0, destructor = false},
	},
	events = {
		{name = "target", signature = "?s", since = 1, fd_count = 0, destructor = false},
		{name = "send", signature = "sh", since = 1, fd_count = 1, destructor = false},
		{name = "cancelled", signature = "", since = 1, fd_count = 0, destructor = false},
		{name = "dnd_drop_performed", signature = "", since = 3, fd_count = 0, destructor = false},
		{name = "dnd_finished", signature = "", since = 3, fd_count = 0, destructor = false},
		{name = "action", signature = "u", since = 3, fd_count = 0, destructor = false},
	},
	dispatch_request = _wl_data_source_dispatch_request,
	dispatch_event = _wl_data_source_dispatch_event,
}

Wl_Data_Source_Error :: enum u32 {
	invalid_action_mask = 0, // action mask contains invalid values
	invalid_source = 1, // source doesn't accept this request
}

Wl_Data_Source_Request :: enum u16 {
	offer = 0,
	destroy = 1,
	set_actions = 2,
}

Wl_Data_Source_Event :: enum u16 {
	target = 0,
	send = 1,
	cancelled = 2,
	dnd_drop_performed = 3,
	dnd_finished = 4,
	action = 5,
}

// server-side request handlers
Wl_Data_Source_Requests :: struct {
	// add an offered mime type
	offer: proc(obj: ^Object, mime_type: string),
	// destroy the data source
	destroy: proc(obj: ^Object),
	// set the available drag-and-drop actions
	set_actions: proc(obj: ^Object, dnd_actions: u32),
}

// client-side event handlers
Wl_Data_Source_Events :: struct {
	// a target accepts an offered mime type
	target: proc(obj: ^Object, mime_type: string),
	// send the data
	send: proc(obj: ^Object, mime_type: string, fd: linux.Fd),
	// selection was cancelled
	cancelled: proc(obj: ^Object),
	// the drag-and-drop operation physically finished
	dnd_drop_performed: proc(obj: ^Object),
	// the drag-and-drop operation concluded
	dnd_finished: proc(obj: ^Object),
	// notify the selected action
	action: proc(obj: ^Object, dnd_action: u32),
}

@(private)
_wl_data_source_dispatch_request :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Data_Source_Requests)(obj.handlers)
	switch opcode {
	case 0: // offer
		a_mime_type := read_string(r, false)
		if !r.ok { return false }
		if h != nil && h.offer != nil {
			h.offer(obj, a_mime_type)
		}
	case 1: // destroy
		if !r.ok { return false }
		if h != nil && h.destroy != nil {
			h.destroy(obj)
		}
		object_destroy(obj)
	case 2: // set_actions
		a_dnd_actions := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.set_actions != nil {
			h.set_actions(obj, a_dnd_actions)
		}
	case:
		return false
	}
	return true
}

@(private)
_wl_data_source_dispatch_event :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Data_Source_Events)(obj.handlers)
	switch opcode {
	case 0: // target
		a_mime_type := read_string(r, true)
		if !r.ok { return false }
		if h != nil && h.target != nil {
			h.target(obj, a_mime_type)
		}
	case 1: // send
		a_mime_type := read_string(r, false)
		a_fd := read_fd(r)
		if !r.ok { return false }
		if h != nil && h.send != nil {
			h.send(obj, a_mime_type, a_fd)
		} else {
			linux.close(a_fd)
		}
	case 2: // cancelled
		if !r.ok { return false }
		if h != nil && h.cancelled != nil {
			h.cancelled(obj)
		}
	case 3: // dnd_drop_performed
		if !r.ok { return false }
		if h != nil && h.dnd_drop_performed != nil {
			h.dnd_drop_performed(obj)
		}
	case 4: // dnd_finished
		if !r.ok { return false }
		if h != nil && h.dnd_finished != nil {
			h.dnd_finished(obj)
		}
	case 5: // action
		a_dnd_action := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.action != nil {
			h.action(obj, a_dnd_action)
		}
	case:
		return false
	}
	return true
}

// a target accepts an offered mime type
wl_data_source_send_target :: proc(obj: ^Object, mime_type: string) {
	w := begin_message(obj, 0)
	write_string(&w, mime_type, true)
	end_message(&w)
}

// send the data
wl_data_source_send_send :: proc(obj: ^Object, mime_type: string, fd: linux.Fd) {
	w := begin_message(obj, 1)
	write_string(&w, mime_type, false)
	write_fd(&w, fd)
	end_message(&w)
}

// selection was cancelled
wl_data_source_send_cancelled :: proc(obj: ^Object) {
	w := begin_message(obj, 2)
	end_message(&w)
}

// the drag-and-drop operation physically finished
wl_data_source_send_dnd_drop_performed :: proc(obj: ^Object) {
	if obj.version < 3 { return }
	w := begin_message(obj, 3)
	end_message(&w)
}

// the drag-and-drop operation concluded
wl_data_source_send_dnd_finished :: proc(obj: ^Object) {
	if obj.version < 3 { return }
	w := begin_message(obj, 4)
	end_message(&w)
}

// notify the selected action
wl_data_source_send_action :: proc(obj: ^Object, dnd_action: u32) {
	if obj.version < 3 { return }
	w := begin_message(obj, 5)
	write_uint(&w, dnd_action)
	end_message(&w)
}

// add an offered mime type
wl_data_source_offer :: proc(obj: ^Object, mime_type: string) {
	w := begin_message(obj, 0)
	write_string(&w, mime_type, false)
	end_message(&w)
}

// destroy the data source
wl_data_source_destroy :: proc(obj: ^Object) {
	w := begin_message(obj, 1)
	end_message(&w)
	object_destroy(obj)
}

// set the available drag-and-drop actions
wl_data_source_set_actions :: proc(obj: ^Object, dnd_actions: u32) {
	if obj.version < 3 { return }
	w := begin_message(obj, 2)
	write_uint(&w, dnd_actions)
	end_message(&w)
}

// ===== wl_data_device (version 4) =====
// data transfer device

wl_data_device_interface := Interface{
	name = "wl_data_device",
	version = 4,
	requests = {
		{name = "start_drag", signature = "?oo?ou", since = 1, fd_count = 0, destructor = false},
		{name = "set_selection", signature = "?ou", since = 1, fd_count = 0, destructor = false},
		{name = "release", signature = "", since = 2, fd_count = 0, destructor = true},
	},
	events = {
		{name = "data_offer", signature = "n", since = 1, fd_count = 0, destructor = false},
		{name = "enter", signature = "uoff?o", since = 1, fd_count = 0, destructor = false},
		{name = "leave", signature = "", since = 1, fd_count = 0, destructor = false},
		{name = "motion", signature = "uff", since = 1, fd_count = 0, destructor = false},
		{name = "drop", signature = "", since = 1, fd_count = 0, destructor = false},
		{name = "selection", signature = "?o", since = 1, fd_count = 0, destructor = false},
	},
	dispatch_request = _wl_data_device_dispatch_request,
	dispatch_event = _wl_data_device_dispatch_event,
}

Wl_Data_Device_Error :: enum u32 {
	role = 0, // given wl_surface has another role
	used_source = 1, // source has already been used
}

Wl_Data_Device_Request :: enum u16 {
	start_drag = 0,
	set_selection = 1,
	release = 2,
}

Wl_Data_Device_Event :: enum u16 {
	data_offer = 0,
	enter = 1,
	leave = 2,
	motion = 3,
	drop = 4,
	selection = 5,
}

// server-side request handlers
Wl_Data_Device_Requests :: struct {
	// start drag-and-drop operation
	start_drag: proc(obj: ^Object, source: ^Object, origin: ^Object, icon: ^Object, serial: u32),
	// copy data to the selection
	set_selection: proc(obj: ^Object, source: ^Object, serial: u32),
	// destroy data device
	release: proc(obj: ^Object),
}

// client-side event handlers
Wl_Data_Device_Events :: struct {
	// introduce a new wl_data_offer
	data_offer: proc(obj: ^Object, id: ^Object),
	// initiate drag-and-drop session
	enter: proc(obj: ^Object, serial: u32, surface: ^Object, x: Fixed, y: Fixed, id: ^Object),
	// end drag-and-drop session
	leave: proc(obj: ^Object),
	// drag-and-drop session motion
	motion: proc(obj: ^Object, time: u32, x: Fixed, y: Fixed),
	// end drag-and-drop session successfully
	drop: proc(obj: ^Object),
	// advertise new selection
	selection: proc(obj: ^Object, id: ^Object),
}

@(private)
_wl_data_device_dispatch_request :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Data_Device_Requests)(obj.handlers)
	switch opcode {
	case 0: // start_drag
		a_source := read_object(r, &wl_data_source_interface, true)
		a_origin := read_object(r, &wl_surface_interface, false)
		a_icon := read_object(r, &wl_surface_interface, true)
		a_serial := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.start_drag != nil {
			h.start_drag(obj, a_source, a_origin, a_icon, a_serial)
		}
	case 1: // set_selection
		a_source := read_object(r, &wl_data_source_interface, true)
		a_serial := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.set_selection != nil {
			h.set_selection(obj, a_source, a_serial)
		}
	case 2: // release
		if !r.ok { return false }
		if h != nil && h.release != nil {
			h.release(obj)
		}
		object_destroy(obj)
	case:
		return false
	}
	return true
}

@(private)
_wl_data_device_dispatch_event :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Data_Device_Events)(obj.handlers)
	switch opcode {
	case 0: // data_offer
		a_id := read_new_id(r, &wl_data_offer_interface, obj.version)
		if !r.ok { return false }
		if h != nil && h.data_offer != nil {
			h.data_offer(obj, a_id)
		}
	case 1: // enter
		a_serial := read_uint(r)
		a_surface := read_object(r, &wl_surface_interface, false)
		a_x := read_fixed(r)
		a_y := read_fixed(r)
		a_id := read_object(r, &wl_data_offer_interface, true)
		if !r.ok { return false }
		if h != nil && h.enter != nil {
			h.enter(obj, a_serial, a_surface, a_x, a_y, a_id)
		}
	case 2: // leave
		if !r.ok { return false }
		if h != nil && h.leave != nil {
			h.leave(obj)
		}
	case 3: // motion
		a_time := read_uint(r)
		a_x := read_fixed(r)
		a_y := read_fixed(r)
		if !r.ok { return false }
		if h != nil && h.motion != nil {
			h.motion(obj, a_time, a_x, a_y)
		}
	case 4: // drop
		if !r.ok { return false }
		if h != nil && h.drop != nil {
			h.drop(obj)
		}
	case 5: // selection
		a_id := read_object(r, &wl_data_offer_interface, true)
		if !r.ok { return false }
		if h != nil && h.selection != nil {
			h.selection(obj, a_id)
		}
	case:
		return false
	}
	return true
}

// introduce a new wl_data_offer
wl_data_device_send_data_offer :: proc(obj: ^Object, id: ^Object) {
	w := begin_message(obj, 0)
	write_object(&w, id)
	end_message(&w)
}

// initiate drag-and-drop session
wl_data_device_send_enter :: proc(obj: ^Object, serial: u32, surface: ^Object, x: Fixed, y: Fixed, id: ^Object) {
	w := begin_message(obj, 1)
	write_uint(&w, serial)
	write_object(&w, surface)
	write_fixed(&w, x)
	write_fixed(&w, y)
	write_object(&w, id)
	end_message(&w)
}

// end drag-and-drop session
wl_data_device_send_leave :: proc(obj: ^Object) {
	w := begin_message(obj, 2)
	end_message(&w)
}

// drag-and-drop session motion
wl_data_device_send_motion :: proc(obj: ^Object, time: u32, x: Fixed, y: Fixed) {
	w := begin_message(obj, 3)
	write_uint(&w, time)
	write_fixed(&w, x)
	write_fixed(&w, y)
	end_message(&w)
}

// end drag-and-drop session successfully
wl_data_device_send_drop :: proc(obj: ^Object) {
	w := begin_message(obj, 4)
	end_message(&w)
}

// advertise new selection
wl_data_device_send_selection :: proc(obj: ^Object, id: ^Object) {
	w := begin_message(obj, 5)
	write_object(&w, id)
	end_message(&w)
}

// start drag-and-drop operation
wl_data_device_start_drag :: proc(obj: ^Object, source: ^Object, origin: ^Object, icon: ^Object, serial: u32) {
	w := begin_message(obj, 0)
	write_object(&w, source)
	write_object(&w, origin)
	write_object(&w, icon)
	write_uint(&w, serial)
	end_message(&w)
}

// copy data to the selection
wl_data_device_set_selection :: proc(obj: ^Object, source: ^Object, serial: u32) {
	w := begin_message(obj, 1)
	write_object(&w, source)
	write_uint(&w, serial)
	end_message(&w)
}

// destroy data device
wl_data_device_release :: proc(obj: ^Object) {
	if obj.version < 2 { return }
	w := begin_message(obj, 2)
	end_message(&w)
	object_destroy(obj)
}

// ===== wl_data_device_manager (version 4) =====
// data transfer interface

wl_data_device_manager_interface := Interface{
	name = "wl_data_device_manager",
	version = 4,
	requests = {
		{name = "create_data_source", signature = "n", since = 1, fd_count = 0, destructor = false},
		{name = "get_data_device", signature = "no", since = 1, fd_count = 0, destructor = false},
		{name = "release", signature = "", since = 4, fd_count = 0, destructor = true},
	},
	events = {
	},
	dispatch_request = _wl_data_device_manager_dispatch_request,
	dispatch_event = _wl_data_device_manager_dispatch_event,
}

Wl_Data_Device_Manager_Dnd_Action :: enum u32 { // bitfield
	none = 0, // no action
	copy = 1, // copy action
	move = 2, // move action
	ask = 4, // ask action
}

Wl_Data_Device_Manager_Request :: enum u16 {
	create_data_source = 0,
	get_data_device = 1,
	release = 2,
}

// server-side request handlers
Wl_Data_Device_Manager_Requests :: struct {
	// create a new data source
	create_data_source: proc(obj: ^Object, id: ^Object),
	// create a new data device
	get_data_device: proc(obj: ^Object, id: ^Object, seat: ^Object),
	// destroy wl_data_device_manager
	release: proc(obj: ^Object),
}

// client-side event handlers
Wl_Data_Device_Manager_Events :: struct {
}

@(private)
_wl_data_device_manager_dispatch_request :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Data_Device_Manager_Requests)(obj.handlers)
	switch opcode {
	case 0: // create_data_source
		a_id := read_new_id(r, &wl_data_source_interface, obj.version)
		if !r.ok { return false }
		if h != nil && h.create_data_source != nil {
			h.create_data_source(obj, a_id)
		}
	case 1: // get_data_device
		a_id := read_new_id(r, &wl_data_device_interface, obj.version)
		a_seat := read_object(r, &wl_seat_interface, false)
		if !r.ok { return false }
		if h != nil && h.get_data_device != nil {
			h.get_data_device(obj, a_id, a_seat)
		}
	case 2: // release
		if !r.ok { return false }
		if h != nil && h.release != nil {
			h.release(obj)
		}
		object_destroy(obj)
	case:
		return false
	}
	return true
}

@(private)
_wl_data_device_manager_dispatch_event :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	return false
}

// create a new data source
wl_data_device_manager_create_data_source :: proc(obj: ^Object) -> ^Object {
	id := object_create(obj.conn, &wl_data_source_interface, obj.version)
	w := begin_message(obj, 0)
	write_object(&w, id)
	end_message(&w)
	return id
}

// create a new data device
wl_data_device_manager_get_data_device :: proc(obj: ^Object, seat: ^Object) -> ^Object {
	id := object_create(obj.conn, &wl_data_device_interface, obj.version)
	w := begin_message(obj, 1)
	write_object(&w, id)
	write_object(&w, seat)
	end_message(&w)
	return id
}

// destroy wl_data_device_manager
wl_data_device_manager_release :: proc(obj: ^Object) {
	if obj.version < 4 { return }
	w := begin_message(obj, 2)
	end_message(&w)
	object_destroy(obj)
}

// ===== wl_shell (version 1) =====
// create desktop-style surfaces

wl_shell_interface := Interface{
	name = "wl_shell",
	version = 1,
	requests = {
		{name = "get_shell_surface", signature = "no", since = 1, fd_count = 0, destructor = false},
	},
	events = {
	},
	dispatch_request = _wl_shell_dispatch_request,
	dispatch_event = _wl_shell_dispatch_event,
}

Wl_Shell_Error :: enum u32 {
	role = 0, // given wl_surface has another role
}

Wl_Shell_Request :: enum u16 {
	get_shell_surface = 0,
}

// server-side request handlers
Wl_Shell_Requests :: struct {
	// create a shell surface from a surface
	get_shell_surface: proc(obj: ^Object, id: ^Object, surface: ^Object),
}

// client-side event handlers
Wl_Shell_Events :: struct {
}

@(private)
_wl_shell_dispatch_request :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Shell_Requests)(obj.handlers)
	switch opcode {
	case 0: // get_shell_surface
		a_id := read_new_id(r, &wl_shell_surface_interface, obj.version)
		a_surface := read_object(r, &wl_surface_interface, false)
		if !r.ok { return false }
		if h != nil && h.get_shell_surface != nil {
			h.get_shell_surface(obj, a_id, a_surface)
		}
	case:
		return false
	}
	return true
}

@(private)
_wl_shell_dispatch_event :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	return false
}

// create a shell surface from a surface
wl_shell_get_shell_surface :: proc(obj: ^Object, surface: ^Object) -> ^Object {
	id := object_create(obj.conn, &wl_shell_surface_interface, obj.version)
	w := begin_message(obj, 0)
	write_object(&w, id)
	write_object(&w, surface)
	end_message(&w)
	return id
}

// ===== wl_shell_surface (version 1) =====
// desktop-style metadata interface

wl_shell_surface_interface := Interface{
	name = "wl_shell_surface",
	version = 1,
	requests = {
		{name = "pong", signature = "u", since = 1, fd_count = 0, destructor = false},
		{name = "move", signature = "ou", since = 1, fd_count = 0, destructor = false},
		{name = "resize", signature = "ouu", since = 1, fd_count = 0, destructor = false},
		{name = "set_toplevel", signature = "", since = 1, fd_count = 0, destructor = false},
		{name = "set_transient", signature = "oiiu", since = 1, fd_count = 0, destructor = false},
		{name = "set_fullscreen", signature = "uu?o", since = 1, fd_count = 0, destructor = false},
		{name = "set_popup", signature = "ouoiiu", since = 1, fd_count = 0, destructor = false},
		{name = "set_maximized", signature = "?o", since = 1, fd_count = 0, destructor = false},
		{name = "set_title", signature = "s", since = 1, fd_count = 0, destructor = false},
		{name = "set_class", signature = "s", since = 1, fd_count = 0, destructor = false},
	},
	events = {
		{name = "ping", signature = "u", since = 1, fd_count = 0, destructor = false},
		{name = "configure", signature = "uii", since = 1, fd_count = 0, destructor = false},
		{name = "popup_done", signature = "", since = 1, fd_count = 0, destructor = false},
	},
	dispatch_request = _wl_shell_surface_dispatch_request,
	dispatch_event = _wl_shell_surface_dispatch_event,
}

Wl_Shell_Surface_Resize :: enum u32 { // bitfield
	none = 0, // no edge
	top = 1, // top edge
	bottom = 2, // bottom edge
	left = 4, // left edge
	top_left = 5, // top and left edges
	bottom_left = 6, // bottom and left edges
	right = 8, // right edge
	top_right = 9, // top and right edges
	bottom_right = 10, // bottom and right edges
}

Wl_Shell_Surface_Transient :: enum u32 { // bitfield
	inactive = 0x1, // do not set keyboard focus
}

Wl_Shell_Surface_Fullscreen_Method :: enum u32 {
	default = 0, // no preference, apply default policy
	scale = 1, // scale, preserve the surface's aspect ratio and center on output
	driver = 2, // switch output mode to the smallest mode that can fit the surface, add black borders to compensate size mismatch
	fill = 3, // no upscaling, center on output and add black borders to compensate size mismatch
}

Wl_Shell_Surface_Request :: enum u16 {
	pong = 0,
	move = 1,
	resize = 2,
	set_toplevel = 3,
	set_transient = 4,
	set_fullscreen = 5,
	set_popup = 6,
	set_maximized = 7,
	set_title = 8,
	set_class = 9,
}

Wl_Shell_Surface_Event :: enum u16 {
	ping = 0,
	configure = 1,
	popup_done = 2,
}

// server-side request handlers
Wl_Shell_Surface_Requests :: struct {
	// respond to a ping event
	pong: proc(obj: ^Object, serial: u32),
	// start an interactive move
	move: proc(obj: ^Object, seat: ^Object, serial: u32),
	// start an interactive resize
	resize: proc(obj: ^Object, seat: ^Object, serial: u32, edges: u32),
	// make the surface a toplevel surface
	set_toplevel: proc(obj: ^Object),
	// make the surface a transient surface
	set_transient: proc(obj: ^Object, parent: ^Object, x: i32, y: i32, flags: u32),
	// make the surface a fullscreen surface
	set_fullscreen: proc(obj: ^Object, method: u32, framerate: u32, output: ^Object),
	// make the surface a popup surface
	set_popup: proc(obj: ^Object, seat: ^Object, serial: u32, parent: ^Object, x: i32, y: i32, flags: u32),
	// make the surface a maximized surface
	set_maximized: proc(obj: ^Object, output: ^Object),
	// set surface title
	set_title: proc(obj: ^Object, title: string),
	// set surface class
	set_class: proc(obj: ^Object, class_: string),
}

// client-side event handlers
Wl_Shell_Surface_Events :: struct {
	// ping client
	ping: proc(obj: ^Object, serial: u32),
	// suggest resize
	configure: proc(obj: ^Object, edges: u32, width: i32, height: i32),
	// popup interaction is done
	popup_done: proc(obj: ^Object),
}

@(private)
_wl_shell_surface_dispatch_request :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Shell_Surface_Requests)(obj.handlers)
	switch opcode {
	case 0: // pong
		a_serial := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.pong != nil {
			h.pong(obj, a_serial)
		}
	case 1: // move
		a_seat := read_object(r, &wl_seat_interface, false)
		a_serial := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.move != nil {
			h.move(obj, a_seat, a_serial)
		}
	case 2: // resize
		a_seat := read_object(r, &wl_seat_interface, false)
		a_serial := read_uint(r)
		a_edges := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.resize != nil {
			h.resize(obj, a_seat, a_serial, a_edges)
		}
	case 3: // set_toplevel
		if !r.ok { return false }
		if h != nil && h.set_toplevel != nil {
			h.set_toplevel(obj)
		}
	case 4: // set_transient
		a_parent := read_object(r, &wl_surface_interface, false)
		a_x := read_int(r)
		a_y := read_int(r)
		a_flags := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.set_transient != nil {
			h.set_transient(obj, a_parent, a_x, a_y, a_flags)
		}
	case 5: // set_fullscreen
		a_method := read_uint(r)
		a_framerate := read_uint(r)
		a_output := read_object(r, &wl_output_interface, true)
		if !r.ok { return false }
		if h != nil && h.set_fullscreen != nil {
			h.set_fullscreen(obj, a_method, a_framerate, a_output)
		}
	case 6: // set_popup
		a_seat := read_object(r, &wl_seat_interface, false)
		a_serial := read_uint(r)
		a_parent := read_object(r, &wl_surface_interface, false)
		a_x := read_int(r)
		a_y := read_int(r)
		a_flags := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.set_popup != nil {
			h.set_popup(obj, a_seat, a_serial, a_parent, a_x, a_y, a_flags)
		}
	case 7: // set_maximized
		a_output := read_object(r, &wl_output_interface, true)
		if !r.ok { return false }
		if h != nil && h.set_maximized != nil {
			h.set_maximized(obj, a_output)
		}
	case 8: // set_title
		a_title := read_string(r, false)
		if !r.ok { return false }
		if h != nil && h.set_title != nil {
			h.set_title(obj, a_title)
		}
	case 9: // set_class
		a_class_ := read_string(r, false)
		if !r.ok { return false }
		if h != nil && h.set_class != nil {
			h.set_class(obj, a_class_)
		}
	case:
		return false
	}
	return true
}

@(private)
_wl_shell_surface_dispatch_event :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Shell_Surface_Events)(obj.handlers)
	switch opcode {
	case 0: // ping
		a_serial := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.ping != nil {
			h.ping(obj, a_serial)
		}
	case 1: // configure
		a_edges := read_uint(r)
		a_width := read_int(r)
		a_height := read_int(r)
		if !r.ok { return false }
		if h != nil && h.configure != nil {
			h.configure(obj, a_edges, a_width, a_height)
		}
	case 2: // popup_done
		if !r.ok { return false }
		if h != nil && h.popup_done != nil {
			h.popup_done(obj)
		}
	case:
		return false
	}
	return true
}

// ping client
wl_shell_surface_send_ping :: proc(obj: ^Object, serial: u32) {
	w := begin_message(obj, 0)
	write_uint(&w, serial)
	end_message(&w)
}

// suggest resize
wl_shell_surface_send_configure :: proc(obj: ^Object, edges: u32, width: i32, height: i32) {
	w := begin_message(obj, 1)
	write_uint(&w, edges)
	write_int(&w, width)
	write_int(&w, height)
	end_message(&w)
}

// popup interaction is done
wl_shell_surface_send_popup_done :: proc(obj: ^Object) {
	w := begin_message(obj, 2)
	end_message(&w)
}

// respond to a ping event
wl_shell_surface_pong :: proc(obj: ^Object, serial: u32) {
	w := begin_message(obj, 0)
	write_uint(&w, serial)
	end_message(&w)
}

// start an interactive move
wl_shell_surface_move :: proc(obj: ^Object, seat: ^Object, serial: u32) {
	w := begin_message(obj, 1)
	write_object(&w, seat)
	write_uint(&w, serial)
	end_message(&w)
}

// start an interactive resize
wl_shell_surface_resize :: proc(obj: ^Object, seat: ^Object, serial: u32, edges: u32) {
	w := begin_message(obj, 2)
	write_object(&w, seat)
	write_uint(&w, serial)
	write_uint(&w, edges)
	end_message(&w)
}

// make the surface a toplevel surface
wl_shell_surface_set_toplevel :: proc(obj: ^Object) {
	w := begin_message(obj, 3)
	end_message(&w)
}

// make the surface a transient surface
wl_shell_surface_set_transient :: proc(obj: ^Object, parent: ^Object, x: i32, y: i32, flags: u32) {
	w := begin_message(obj, 4)
	write_object(&w, parent)
	write_int(&w, x)
	write_int(&w, y)
	write_uint(&w, flags)
	end_message(&w)
}

// make the surface a fullscreen surface
wl_shell_surface_set_fullscreen :: proc(obj: ^Object, method: u32, framerate: u32, output: ^Object) {
	w := begin_message(obj, 5)
	write_uint(&w, method)
	write_uint(&w, framerate)
	write_object(&w, output)
	end_message(&w)
}

// make the surface a popup surface
wl_shell_surface_set_popup :: proc(obj: ^Object, seat: ^Object, serial: u32, parent: ^Object, x: i32, y: i32, flags: u32) {
	w := begin_message(obj, 6)
	write_object(&w, seat)
	write_uint(&w, serial)
	write_object(&w, parent)
	write_int(&w, x)
	write_int(&w, y)
	write_uint(&w, flags)
	end_message(&w)
}

// make the surface a maximized surface
wl_shell_surface_set_maximized :: proc(obj: ^Object, output: ^Object) {
	w := begin_message(obj, 7)
	write_object(&w, output)
	end_message(&w)
}

// set surface title
wl_shell_surface_set_title :: proc(obj: ^Object, title: string) {
	w := begin_message(obj, 8)
	write_string(&w, title, false)
	end_message(&w)
}

// set surface class
wl_shell_surface_set_class :: proc(obj: ^Object, class_: string) {
	w := begin_message(obj, 9)
	write_string(&w, class_, false)
	end_message(&w)
}

// ===== wl_surface (version 7) =====
// an onscreen surface

wl_surface_interface := Interface{
	name = "wl_surface",
	version = 7,
	requests = {
		{name = "destroy", signature = "", since = 1, fd_count = 0, destructor = true},
		{name = "attach", signature = "?oii", since = 1, fd_count = 0, destructor = false},
		{name = "damage", signature = "iiii", since = 1, fd_count = 0, destructor = false},
		{name = "frame", signature = "n", since = 1, fd_count = 0, destructor = false},
		{name = "set_opaque_region", signature = "?o", since = 1, fd_count = 0, destructor = false},
		{name = "set_input_region", signature = "?o", since = 1, fd_count = 0, destructor = false},
		{name = "commit", signature = "", since = 1, fd_count = 0, destructor = false},
		{name = "set_buffer_transform", signature = "i", since = 2, fd_count = 0, destructor = false},
		{name = "set_buffer_scale", signature = "i", since = 3, fd_count = 0, destructor = false},
		{name = "damage_buffer", signature = "iiii", since = 4, fd_count = 0, destructor = false},
		{name = "offset", signature = "ii", since = 5, fd_count = 0, destructor = false},
		{name = "get_release", signature = "n", since = 7, fd_count = 0, destructor = false},
	},
	events = {
		{name = "enter", signature = "o", since = 1, fd_count = 0, destructor = false},
		{name = "leave", signature = "o", since = 1, fd_count = 0, destructor = false},
		{name = "preferred_buffer_scale", signature = "i", since = 6, fd_count = 0, destructor = false},
		{name = "preferred_buffer_transform", signature = "u", since = 6, fd_count = 0, destructor = false},
	},
	dispatch_request = _wl_surface_dispatch_request,
	dispatch_event = _wl_surface_dispatch_event,
}

Wl_Surface_Error :: enum u32 {
	invalid_scale = 0, // buffer scale value is invalid
	invalid_transform = 1, // buffer transform value is invalid
	invalid_size = 2, // buffer size is invalid
	invalid_offset = 3, // buffer offset is invalid
	defunct_role_object = 4, // surface was destroyed before its role object
	no_buffer = 5, // no buffer was attached
}

Wl_Surface_Request :: enum u16 {
	destroy = 0,
	attach = 1,
	damage = 2,
	frame = 3,
	set_opaque_region = 4,
	set_input_region = 5,
	commit = 6,
	set_buffer_transform = 7,
	set_buffer_scale = 8,
	damage_buffer = 9,
	offset = 10,
	get_release = 11,
}

Wl_Surface_Event :: enum u16 {
	enter = 0,
	leave = 1,
	preferred_buffer_scale = 2,
	preferred_buffer_transform = 3,
}

// server-side request handlers
Wl_Surface_Requests :: struct {
	// delete surface
	destroy: proc(obj: ^Object),
	// set the surface contents
	attach: proc(obj: ^Object, buffer: ^Object, x: i32, y: i32),
	// mark part of the surface damaged
	damage: proc(obj: ^Object, x: i32, y: i32, width: i32, height: i32),
	// request a frame throttling hint
	frame: proc(obj: ^Object, callback: ^Object),
	// set opaque region
	set_opaque_region: proc(obj: ^Object, region: ^Object),
	// set input region
	set_input_region: proc(obj: ^Object, region: ^Object),
	// commit pending surface state
	commit: proc(obj: ^Object),
	// sets the buffer transformation
	set_buffer_transform: proc(obj: ^Object, transform: i32),
	// sets the buffer scaling factor
	set_buffer_scale: proc(obj: ^Object, scale: i32),
	// mark part of the surface damaged using buffer coordinates
	damage_buffer: proc(obj: ^Object, x: i32, y: i32, width: i32, height: i32),
	// set the surface contents offset
	offset: proc(obj: ^Object, x: i32, y: i32),
	// get a release callback
	get_release: proc(obj: ^Object, callback: ^Object),
}

// client-side event handlers
Wl_Surface_Events :: struct {
	// surface enters an output
	enter: proc(obj: ^Object, output: ^Object),
	// surface leaves an output
	leave: proc(obj: ^Object, output: ^Object),
	// preferred buffer scale for the surface
	preferred_buffer_scale: proc(obj: ^Object, factor: i32),
	// preferred buffer transform for the surface
	preferred_buffer_transform: proc(obj: ^Object, transform: u32),
}

@(private)
_wl_surface_dispatch_request :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Surface_Requests)(obj.handlers)
	switch opcode {
	case 0: // destroy
		if !r.ok { return false }
		if h != nil && h.destroy != nil {
			h.destroy(obj)
		}
		object_destroy(obj)
	case 1: // attach
		a_buffer := read_object(r, &wl_buffer_interface, true)
		a_x := read_int(r)
		a_y := read_int(r)
		if !r.ok { return false }
		if h != nil && h.attach != nil {
			h.attach(obj, a_buffer, a_x, a_y)
		}
	case 2: // damage
		a_x := read_int(r)
		a_y := read_int(r)
		a_width := read_int(r)
		a_height := read_int(r)
		if !r.ok { return false }
		if h != nil && h.damage != nil {
			h.damage(obj, a_x, a_y, a_width, a_height)
		}
	case 3: // frame
		a_callback := read_new_id(r, &wl_callback_interface, obj.version)
		if !r.ok { return false }
		if h != nil && h.frame != nil {
			h.frame(obj, a_callback)
		}
	case 4: // set_opaque_region
		a_region := read_object(r, &wl_region_interface, true)
		if !r.ok { return false }
		if h != nil && h.set_opaque_region != nil {
			h.set_opaque_region(obj, a_region)
		}
	case 5: // set_input_region
		a_region := read_object(r, &wl_region_interface, true)
		if !r.ok { return false }
		if h != nil && h.set_input_region != nil {
			h.set_input_region(obj, a_region)
		}
	case 6: // commit
		if !r.ok { return false }
		if h != nil && h.commit != nil {
			h.commit(obj)
		}
	case 7: // set_buffer_transform
		a_transform := read_int(r)
		if !r.ok { return false }
		if h != nil && h.set_buffer_transform != nil {
			h.set_buffer_transform(obj, a_transform)
		}
	case 8: // set_buffer_scale
		a_scale := read_int(r)
		if !r.ok { return false }
		if h != nil && h.set_buffer_scale != nil {
			h.set_buffer_scale(obj, a_scale)
		}
	case 9: // damage_buffer
		a_x := read_int(r)
		a_y := read_int(r)
		a_width := read_int(r)
		a_height := read_int(r)
		if !r.ok { return false }
		if h != nil && h.damage_buffer != nil {
			h.damage_buffer(obj, a_x, a_y, a_width, a_height)
		}
	case 10: // offset
		a_x := read_int(r)
		a_y := read_int(r)
		if !r.ok { return false }
		if h != nil && h.offset != nil {
			h.offset(obj, a_x, a_y)
		}
	case 11: // get_release
		a_callback := read_new_id(r, &wl_callback_interface, obj.version)
		if !r.ok { return false }
		if h != nil && h.get_release != nil {
			h.get_release(obj, a_callback)
		}
	case:
		return false
	}
	return true
}

@(private)
_wl_surface_dispatch_event :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Surface_Events)(obj.handlers)
	switch opcode {
	case 0: // enter
		a_output := read_object(r, &wl_output_interface, false)
		if !r.ok { return false }
		if h != nil && h.enter != nil {
			h.enter(obj, a_output)
		}
	case 1: // leave
		a_output := read_object(r, &wl_output_interface, false)
		if !r.ok { return false }
		if h != nil && h.leave != nil {
			h.leave(obj, a_output)
		}
	case 2: // preferred_buffer_scale
		a_factor := read_int(r)
		if !r.ok { return false }
		if h != nil && h.preferred_buffer_scale != nil {
			h.preferred_buffer_scale(obj, a_factor)
		}
	case 3: // preferred_buffer_transform
		a_transform := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.preferred_buffer_transform != nil {
			h.preferred_buffer_transform(obj, a_transform)
		}
	case:
		return false
	}
	return true
}

// surface enters an output
wl_surface_send_enter :: proc(obj: ^Object, output: ^Object) {
	w := begin_message(obj, 0)
	write_object(&w, output)
	end_message(&w)
}

// surface leaves an output
wl_surface_send_leave :: proc(obj: ^Object, output: ^Object) {
	w := begin_message(obj, 1)
	write_object(&w, output)
	end_message(&w)
}

// preferred buffer scale for the surface
wl_surface_send_preferred_buffer_scale :: proc(obj: ^Object, factor: i32) {
	if obj.version < 6 { return }
	w := begin_message(obj, 2)
	write_int(&w, factor)
	end_message(&w)
}

// preferred buffer transform for the surface
wl_surface_send_preferred_buffer_transform :: proc(obj: ^Object, transform: u32) {
	if obj.version < 6 { return }
	w := begin_message(obj, 3)
	write_uint(&w, transform)
	end_message(&w)
}

// delete surface
wl_surface_destroy :: proc(obj: ^Object) {
	w := begin_message(obj, 0)
	end_message(&w)
	object_destroy(obj)
}

// set the surface contents
wl_surface_attach :: proc(obj: ^Object, buffer: ^Object, x: i32, y: i32) {
	w := begin_message(obj, 1)
	write_object(&w, buffer)
	write_int(&w, x)
	write_int(&w, y)
	end_message(&w)
}

// mark part of the surface damaged
wl_surface_damage :: proc(obj: ^Object, x: i32, y: i32, width: i32, height: i32) {
	w := begin_message(obj, 2)
	write_int(&w, x)
	write_int(&w, y)
	write_int(&w, width)
	write_int(&w, height)
	end_message(&w)
}

// request a frame throttling hint
wl_surface_frame :: proc(obj: ^Object) -> ^Object {
	callback := object_create(obj.conn, &wl_callback_interface, obj.version)
	w := begin_message(obj, 3)
	write_object(&w, callback)
	end_message(&w)
	return callback
}

// set opaque region
wl_surface_set_opaque_region :: proc(obj: ^Object, region: ^Object) {
	w := begin_message(obj, 4)
	write_object(&w, region)
	end_message(&w)
}

// set input region
wl_surface_set_input_region :: proc(obj: ^Object, region: ^Object) {
	w := begin_message(obj, 5)
	write_object(&w, region)
	end_message(&w)
}

// commit pending surface state
wl_surface_commit :: proc(obj: ^Object) {
	w := begin_message(obj, 6)
	end_message(&w)
}

// sets the buffer transformation
wl_surface_set_buffer_transform :: proc(obj: ^Object, transform: i32) {
	if obj.version < 2 { return }
	w := begin_message(obj, 7)
	write_int(&w, transform)
	end_message(&w)
}

// sets the buffer scaling factor
wl_surface_set_buffer_scale :: proc(obj: ^Object, scale: i32) {
	if obj.version < 3 { return }
	w := begin_message(obj, 8)
	write_int(&w, scale)
	end_message(&w)
}

// mark part of the surface damaged using buffer coordinates
wl_surface_damage_buffer :: proc(obj: ^Object, x: i32, y: i32, width: i32, height: i32) {
	if obj.version < 4 { return }
	w := begin_message(obj, 9)
	write_int(&w, x)
	write_int(&w, y)
	write_int(&w, width)
	write_int(&w, height)
	end_message(&w)
}

// set the surface contents offset
wl_surface_offset :: proc(obj: ^Object, x: i32, y: i32) {
	if obj.version < 5 { return }
	w := begin_message(obj, 10)
	write_int(&w, x)
	write_int(&w, y)
	end_message(&w)
}

// get a release callback
wl_surface_get_release :: proc(obj: ^Object) -> ^Object {
	if obj.version < 7 { return nil }
	callback := object_create(obj.conn, &wl_callback_interface, obj.version)
	w := begin_message(obj, 11)
	write_object(&w, callback)
	end_message(&w)
	return callback
}

// ===== wl_seat (version 11) =====
// group of input devices

wl_seat_interface := Interface{
	name = "wl_seat",
	version = 11,
	requests = {
		{name = "get_pointer", signature = "n", since = 1, fd_count = 0, destructor = false},
		{name = "get_keyboard", signature = "n", since = 1, fd_count = 0, destructor = false},
		{name = "get_touch", signature = "n", since = 1, fd_count = 0, destructor = false},
		{name = "release", signature = "", since = 5, fd_count = 0, destructor = true},
	},
	events = {
		{name = "capabilities", signature = "u", since = 1, fd_count = 0, destructor = false},
		{name = "name", signature = "s", since = 2, fd_count = 0, destructor = false},
	},
	dispatch_request = _wl_seat_dispatch_request,
	dispatch_event = _wl_seat_dispatch_event,
}

Wl_Seat_Capability :: enum u32 { // bitfield
	pointer = 1, // the seat has pointer devices
	keyboard = 2, // the seat has one or more keyboards
	touch = 4, // the seat has touch devices
}

Wl_Seat_Error :: enum u32 {
	missing_capability = 0, // get_pointer, get_keyboard or get_touch called on seat without the matching capability
}

Wl_Seat_Request :: enum u16 {
	get_pointer = 0,
	get_keyboard = 1,
	get_touch = 2,
	release = 3,
}

Wl_Seat_Event :: enum u16 {
	capabilities = 0,
	name = 1,
}

// server-side request handlers
Wl_Seat_Requests :: struct {
	// return pointer object
	get_pointer: proc(obj: ^Object, id: ^Object),
	// return keyboard object
	get_keyboard: proc(obj: ^Object, id: ^Object),
	// return touch object
	get_touch: proc(obj: ^Object, id: ^Object),
	// release the seat object
	release: proc(obj: ^Object),
}

// client-side event handlers
Wl_Seat_Events :: struct {
	// seat capabilities changed
	capabilities: proc(obj: ^Object, capabilities: u32),
	// unique identifier for this seat
	name: proc(obj: ^Object, name: string),
}

@(private)
_wl_seat_dispatch_request :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Seat_Requests)(obj.handlers)
	switch opcode {
	case 0: // get_pointer
		a_id := read_new_id(r, &wl_pointer_interface, obj.version)
		if !r.ok { return false }
		if h != nil && h.get_pointer != nil {
			h.get_pointer(obj, a_id)
		}
	case 1: // get_keyboard
		a_id := read_new_id(r, &wl_keyboard_interface, obj.version)
		if !r.ok { return false }
		if h != nil && h.get_keyboard != nil {
			h.get_keyboard(obj, a_id)
		}
	case 2: // get_touch
		a_id := read_new_id(r, &wl_touch_interface, obj.version)
		if !r.ok { return false }
		if h != nil && h.get_touch != nil {
			h.get_touch(obj, a_id)
		}
	case 3: // release
		if !r.ok { return false }
		if h != nil && h.release != nil {
			h.release(obj)
		}
		object_destroy(obj)
	case:
		return false
	}
	return true
}

@(private)
_wl_seat_dispatch_event :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Seat_Events)(obj.handlers)
	switch opcode {
	case 0: // capabilities
		a_capabilities := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.capabilities != nil {
			h.capabilities(obj, a_capabilities)
		}
	case 1: // name
		a_name := read_string(r, false)
		if !r.ok { return false }
		if h != nil && h.name != nil {
			h.name(obj, a_name)
		}
	case:
		return false
	}
	return true
}

// seat capabilities changed
wl_seat_send_capabilities :: proc(obj: ^Object, capabilities: u32) {
	w := begin_message(obj, 0)
	write_uint(&w, capabilities)
	end_message(&w)
}

// unique identifier for this seat
wl_seat_send_name :: proc(obj: ^Object, name: string) {
	if obj.version < 2 { return }
	w := begin_message(obj, 1)
	write_string(&w, name, false)
	end_message(&w)
}

// return pointer object
wl_seat_get_pointer :: proc(obj: ^Object) -> ^Object {
	id := object_create(obj.conn, &wl_pointer_interface, obj.version)
	w := begin_message(obj, 0)
	write_object(&w, id)
	end_message(&w)
	return id
}

// return keyboard object
wl_seat_get_keyboard :: proc(obj: ^Object) -> ^Object {
	id := object_create(obj.conn, &wl_keyboard_interface, obj.version)
	w := begin_message(obj, 1)
	write_object(&w, id)
	end_message(&w)
	return id
}

// return touch object
wl_seat_get_touch :: proc(obj: ^Object) -> ^Object {
	id := object_create(obj.conn, &wl_touch_interface, obj.version)
	w := begin_message(obj, 2)
	write_object(&w, id)
	end_message(&w)
	return id
}

// release the seat object
wl_seat_release :: proc(obj: ^Object) {
	if obj.version < 5 { return }
	w := begin_message(obj, 3)
	end_message(&w)
	object_destroy(obj)
}

// ===== wl_pointer (version 11) =====
// pointer input device

wl_pointer_interface := Interface{
	name = "wl_pointer",
	version = 11,
	requests = {
		{name = "set_cursor", signature = "u?oii", since = 1, fd_count = 0, destructor = false},
		{name = "release", signature = "", since = 3, fd_count = 0, destructor = true},
	},
	events = {
		{name = "enter", signature = "uoff", since = 1, fd_count = 0, destructor = false},
		{name = "leave", signature = "uo", since = 1, fd_count = 0, destructor = false},
		{name = "motion", signature = "uff", since = 1, fd_count = 0, destructor = false},
		{name = "button", signature = "uuuu", since = 1, fd_count = 0, destructor = false},
		{name = "axis", signature = "uuf", since = 1, fd_count = 0, destructor = false},
		{name = "frame", signature = "", since = 5, fd_count = 0, destructor = false},
		{name = "axis_source", signature = "u", since = 5, fd_count = 0, destructor = false},
		{name = "axis_stop", signature = "uu", since = 5, fd_count = 0, destructor = false},
		{name = "axis_discrete", signature = "ui", since = 5, fd_count = 0, destructor = false},
		{name = "axis_value120", signature = "ui", since = 8, fd_count = 0, destructor = false},
		{name = "axis_relative_direction", signature = "uu", since = 9, fd_count = 0, destructor = false},
		{name = "warp", signature = "ff", since = 11, fd_count = 0, destructor = false},
	},
	dispatch_request = _wl_pointer_dispatch_request,
	dispatch_event = _wl_pointer_dispatch_event,
}

Wl_Pointer_Error :: enum u32 {
	role = 0, // given wl_surface has another role
}

Wl_Pointer_Button_State :: enum u32 {
	released = 0, // the button is not pressed
	pressed = 1, // the button is pressed
}

Wl_Pointer_Axis :: enum u32 {
	vertical_scroll = 0, // vertical axis
	horizontal_scroll = 1, // horizontal axis
}

Wl_Pointer_Axis_Source :: enum u32 {
	wheel = 0, // a physical wheel rotation
	finger = 1, // finger on a touch surface
	continuous = 2, // continuous coordinate space
	wheel_tilt = 3, // a physical wheel tilt
}

Wl_Pointer_Axis_Relative_Direction :: enum u32 {
	identical = 0, // physical motion matches axis direction
	inverted = 1, // physical motion is the inverse of the axis direction
}

Wl_Pointer_Request :: enum u16 {
	set_cursor = 0,
	release = 1,
}

Wl_Pointer_Event :: enum u16 {
	enter = 0,
	leave = 1,
	motion = 2,
	button = 3,
	axis = 4,
	frame = 5,
	axis_source = 6,
	axis_stop = 7,
	axis_discrete = 8,
	axis_value120 = 9,
	axis_relative_direction = 10,
	warp = 11,
}

// server-side request handlers
Wl_Pointer_Requests :: struct {
	// set the pointer surface
	set_cursor: proc(obj: ^Object, serial: u32, surface: ^Object, hotspot_x: i32, hotspot_y: i32),
	// release the pointer object
	release: proc(obj: ^Object),
}

// client-side event handlers
Wl_Pointer_Events :: struct {
	// enter event
	enter: proc(obj: ^Object, serial: u32, surface: ^Object, surface_x: Fixed, surface_y: Fixed),
	// leave event
	leave: proc(obj: ^Object, serial: u32, surface: ^Object),
	// pointer motion event
	motion: proc(obj: ^Object, time: u32, surface_x: Fixed, surface_y: Fixed),
	// pointer button event
	button: proc(obj: ^Object, serial: u32, time: u32, button: u32, state: u32),
	// axis event
	axis: proc(obj: ^Object, time: u32, axis: u32, value: Fixed),
	// end of a pointer event sequence
	frame: proc(obj: ^Object),
	// axis source event
	axis_source: proc(obj: ^Object, axis_source: u32),
	// axis stop event
	axis_stop: proc(obj: ^Object, time: u32, axis: u32),
	// axis click event
	axis_discrete: proc(obj: ^Object, axis: u32, discrete: i32),
	// axis high-resolution scroll event
	axis_value120: proc(obj: ^Object, axis: u32, value120: i32),
	// axis relative physical direction event
	axis_relative_direction: proc(obj: ^Object, axis: u32, direction: u32),
	// pointer warp event
	warp: proc(obj: ^Object, surface_x: Fixed, surface_y: Fixed),
}

@(private)
_wl_pointer_dispatch_request :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Pointer_Requests)(obj.handlers)
	switch opcode {
	case 0: // set_cursor
		a_serial := read_uint(r)
		a_surface := read_object(r, &wl_surface_interface, true)
		a_hotspot_x := read_int(r)
		a_hotspot_y := read_int(r)
		if !r.ok { return false }
		if h != nil && h.set_cursor != nil {
			h.set_cursor(obj, a_serial, a_surface, a_hotspot_x, a_hotspot_y)
		}
	case 1: // release
		if !r.ok { return false }
		if h != nil && h.release != nil {
			h.release(obj)
		}
		object_destroy(obj)
	case:
		return false
	}
	return true
}

@(private)
_wl_pointer_dispatch_event :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Pointer_Events)(obj.handlers)
	switch opcode {
	case 0: // enter
		a_serial := read_uint(r)
		a_surface := read_object(r, &wl_surface_interface, false)
		a_surface_x := read_fixed(r)
		a_surface_y := read_fixed(r)
		if !r.ok { return false }
		if h != nil && h.enter != nil {
			h.enter(obj, a_serial, a_surface, a_surface_x, a_surface_y)
		}
	case 1: // leave
		a_serial := read_uint(r)
		a_surface := read_object(r, &wl_surface_interface, false)
		if !r.ok { return false }
		if h != nil && h.leave != nil {
			h.leave(obj, a_serial, a_surface)
		}
	case 2: // motion
		a_time := read_uint(r)
		a_surface_x := read_fixed(r)
		a_surface_y := read_fixed(r)
		if !r.ok { return false }
		if h != nil && h.motion != nil {
			h.motion(obj, a_time, a_surface_x, a_surface_y)
		}
	case 3: // button
		a_serial := read_uint(r)
		a_time := read_uint(r)
		a_button := read_uint(r)
		a_state := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.button != nil {
			h.button(obj, a_serial, a_time, a_button, a_state)
		}
	case 4: // axis
		a_time := read_uint(r)
		a_axis := read_uint(r)
		a_value := read_fixed(r)
		if !r.ok { return false }
		if h != nil && h.axis != nil {
			h.axis(obj, a_time, a_axis, a_value)
		}
	case 5: // frame
		if !r.ok { return false }
		if h != nil && h.frame != nil {
			h.frame(obj)
		}
	case 6: // axis_source
		a_axis_source := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.axis_source != nil {
			h.axis_source(obj, a_axis_source)
		}
	case 7: // axis_stop
		a_time := read_uint(r)
		a_axis := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.axis_stop != nil {
			h.axis_stop(obj, a_time, a_axis)
		}
	case 8: // axis_discrete
		a_axis := read_uint(r)
		a_discrete := read_int(r)
		if !r.ok { return false }
		if h != nil && h.axis_discrete != nil {
			h.axis_discrete(obj, a_axis, a_discrete)
		}
	case 9: // axis_value120
		a_axis := read_uint(r)
		a_value120 := read_int(r)
		if !r.ok { return false }
		if h != nil && h.axis_value120 != nil {
			h.axis_value120(obj, a_axis, a_value120)
		}
	case 10: // axis_relative_direction
		a_axis := read_uint(r)
		a_direction := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.axis_relative_direction != nil {
			h.axis_relative_direction(obj, a_axis, a_direction)
		}
	case 11: // warp
		a_surface_x := read_fixed(r)
		a_surface_y := read_fixed(r)
		if !r.ok { return false }
		if h != nil && h.warp != nil {
			h.warp(obj, a_surface_x, a_surface_y)
		}
	case:
		return false
	}
	return true
}

// enter event
wl_pointer_send_enter :: proc(obj: ^Object, serial: u32, surface: ^Object, surface_x: Fixed, surface_y: Fixed) {
	w := begin_message(obj, 0)
	write_uint(&w, serial)
	write_object(&w, surface)
	write_fixed(&w, surface_x)
	write_fixed(&w, surface_y)
	end_message(&w)
}

// leave event
wl_pointer_send_leave :: proc(obj: ^Object, serial: u32, surface: ^Object) {
	w := begin_message(obj, 1)
	write_uint(&w, serial)
	write_object(&w, surface)
	end_message(&w)
}

// pointer motion event
wl_pointer_send_motion :: proc(obj: ^Object, time: u32, surface_x: Fixed, surface_y: Fixed) {
	w := begin_message(obj, 2)
	write_uint(&w, time)
	write_fixed(&w, surface_x)
	write_fixed(&w, surface_y)
	end_message(&w)
}

// pointer button event
wl_pointer_send_button :: proc(obj: ^Object, serial: u32, time: u32, button: u32, state: u32) {
	w := begin_message(obj, 3)
	write_uint(&w, serial)
	write_uint(&w, time)
	write_uint(&w, button)
	write_uint(&w, state)
	end_message(&w)
}

// axis event
wl_pointer_send_axis :: proc(obj: ^Object, time: u32, axis: u32, value: Fixed) {
	w := begin_message(obj, 4)
	write_uint(&w, time)
	write_uint(&w, axis)
	write_fixed(&w, value)
	end_message(&w)
}

// end of a pointer event sequence
wl_pointer_send_frame :: proc(obj: ^Object) {
	if obj.version < 5 { return }
	w := begin_message(obj, 5)
	end_message(&w)
}

// axis source event
wl_pointer_send_axis_source :: proc(obj: ^Object, axis_source: u32) {
	if obj.version < 5 { return }
	w := begin_message(obj, 6)
	write_uint(&w, axis_source)
	end_message(&w)
}

// axis stop event
wl_pointer_send_axis_stop :: proc(obj: ^Object, time: u32, axis: u32) {
	if obj.version < 5 { return }
	w := begin_message(obj, 7)
	write_uint(&w, time)
	write_uint(&w, axis)
	end_message(&w)
}

// axis click event
wl_pointer_send_axis_discrete :: proc(obj: ^Object, axis: u32, discrete: i32) {
	if obj.version < 5 { return }
	w := begin_message(obj, 8)
	write_uint(&w, axis)
	write_int(&w, discrete)
	end_message(&w)
}

// axis high-resolution scroll event
wl_pointer_send_axis_value120 :: proc(obj: ^Object, axis: u32, value120: i32) {
	if obj.version < 8 { return }
	w := begin_message(obj, 9)
	write_uint(&w, axis)
	write_int(&w, value120)
	end_message(&w)
}

// axis relative physical direction event
wl_pointer_send_axis_relative_direction :: proc(obj: ^Object, axis: u32, direction: u32) {
	if obj.version < 9 { return }
	w := begin_message(obj, 10)
	write_uint(&w, axis)
	write_uint(&w, direction)
	end_message(&w)
}

// pointer warp event
wl_pointer_send_warp :: proc(obj: ^Object, surface_x: Fixed, surface_y: Fixed) {
	if obj.version < 11 { return }
	w := begin_message(obj, 11)
	write_fixed(&w, surface_x)
	write_fixed(&w, surface_y)
	end_message(&w)
}

// set the pointer surface
wl_pointer_set_cursor :: proc(obj: ^Object, serial: u32, surface: ^Object, hotspot_x: i32, hotspot_y: i32) {
	w := begin_message(obj, 0)
	write_uint(&w, serial)
	write_object(&w, surface)
	write_int(&w, hotspot_x)
	write_int(&w, hotspot_y)
	end_message(&w)
}

// release the pointer object
wl_pointer_release :: proc(obj: ^Object) {
	if obj.version < 3 { return }
	w := begin_message(obj, 1)
	end_message(&w)
	object_destroy(obj)
}

// ===== wl_keyboard (version 11) =====
// keyboard input device

wl_keyboard_interface := Interface{
	name = "wl_keyboard",
	version = 11,
	requests = {
		{name = "release", signature = "", since = 3, fd_count = 0, destructor = true},
	},
	events = {
		{name = "keymap", signature = "uhu", since = 1, fd_count = 1, destructor = false},
		{name = "enter", signature = "uoa", since = 1, fd_count = 0, destructor = false},
		{name = "leave", signature = "uo", since = 1, fd_count = 0, destructor = false},
		{name = "key", signature = "uuuu", since = 1, fd_count = 0, destructor = false},
		{name = "modifiers", signature = "uuuuu", since = 1, fd_count = 0, destructor = false},
		{name = "repeat_info", signature = "ii", since = 4, fd_count = 0, destructor = false},
	},
	dispatch_request = _wl_keyboard_dispatch_request,
	dispatch_event = _wl_keyboard_dispatch_event,
}

Wl_Keyboard_Keymap_Format :: enum u32 {
	no_keymap = 0, // no keymap; client must understand how to interpret the raw keycode
	xkb_v1 = 1, // libxkbcommon compatible, null-terminated string; to determine the xkb keycode, clients must add 8 to the key event keycode
}

Wl_Keyboard_Key_State :: enum u32 {
	released = 0, // key is not pressed
	pressed = 1, // key is pressed
	repeated = 2, // key was repeated
}

Wl_Keyboard_Request :: enum u16 {
	release = 0,
}

Wl_Keyboard_Event :: enum u16 {
	keymap = 0,
	enter = 1,
	leave = 2,
	key = 3,
	modifiers = 4,
	repeat_info = 5,
}

// server-side request handlers
Wl_Keyboard_Requests :: struct {
	// release the keyboard object
	release: proc(obj: ^Object),
}

// client-side event handlers
Wl_Keyboard_Events :: struct {
	// keyboard mapping
	keymap: proc(obj: ^Object, format: u32, fd: linux.Fd, size: u32),
	// enter event
	enter: proc(obj: ^Object, serial: u32, surface: ^Object, keys: []u8),
	// leave event
	leave: proc(obj: ^Object, serial: u32, surface: ^Object),
	// key event
	key: proc(obj: ^Object, serial: u32, time: u32, key: u32, state: u32),
	// modifier and group state
	modifiers: proc(obj: ^Object, serial: u32, mods_depressed: u32, mods_latched: u32, mods_locked: u32, group: u32),
	// repeat rate and delay
	repeat_info: proc(obj: ^Object, rate: i32, delay: i32),
}

@(private)
_wl_keyboard_dispatch_request :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Keyboard_Requests)(obj.handlers)
	switch opcode {
	case 0: // release
		if !r.ok { return false }
		if h != nil && h.release != nil {
			h.release(obj)
		}
		object_destroy(obj)
	case:
		return false
	}
	return true
}

@(private)
_wl_keyboard_dispatch_event :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Keyboard_Events)(obj.handlers)
	switch opcode {
	case 0: // keymap
		a_format := read_uint(r)
		a_fd := read_fd(r)
		a_size := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.keymap != nil {
			h.keymap(obj, a_format, a_fd, a_size)
		} else {
			linux.close(a_fd)
		}
	case 1: // enter
		a_serial := read_uint(r)
		a_surface := read_object(r, &wl_surface_interface, false)
		a_keys := read_array(r)
		if !r.ok { return false }
		if h != nil && h.enter != nil {
			h.enter(obj, a_serial, a_surface, a_keys)
		}
	case 2: // leave
		a_serial := read_uint(r)
		a_surface := read_object(r, &wl_surface_interface, false)
		if !r.ok { return false }
		if h != nil && h.leave != nil {
			h.leave(obj, a_serial, a_surface)
		}
	case 3: // key
		a_serial := read_uint(r)
		a_time := read_uint(r)
		a_key := read_uint(r)
		a_state := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.key != nil {
			h.key(obj, a_serial, a_time, a_key, a_state)
		}
	case 4: // modifiers
		a_serial := read_uint(r)
		a_mods_depressed := read_uint(r)
		a_mods_latched := read_uint(r)
		a_mods_locked := read_uint(r)
		a_group := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.modifiers != nil {
			h.modifiers(obj, a_serial, a_mods_depressed, a_mods_latched, a_mods_locked, a_group)
		}
	case 5: // repeat_info
		a_rate := read_int(r)
		a_delay := read_int(r)
		if !r.ok { return false }
		if h != nil && h.repeat_info != nil {
			h.repeat_info(obj, a_rate, a_delay)
		}
	case:
		return false
	}
	return true
}

// keyboard mapping
wl_keyboard_send_keymap :: proc(obj: ^Object, format: u32, fd: linux.Fd, size: u32) {
	w := begin_message(obj, 0)
	write_uint(&w, format)
	write_fd(&w, fd)
	write_uint(&w, size)
	end_message(&w)
}

// enter event
wl_keyboard_send_enter :: proc(obj: ^Object, serial: u32, surface: ^Object, keys: []u8) {
	w := begin_message(obj, 1)
	write_uint(&w, serial)
	write_object(&w, surface)
	write_array(&w, keys)
	end_message(&w)
}

// leave event
wl_keyboard_send_leave :: proc(obj: ^Object, serial: u32, surface: ^Object) {
	w := begin_message(obj, 2)
	write_uint(&w, serial)
	write_object(&w, surface)
	end_message(&w)
}

// key event
wl_keyboard_send_key :: proc(obj: ^Object, serial: u32, time: u32, key: u32, state: u32) {
	w := begin_message(obj, 3)
	write_uint(&w, serial)
	write_uint(&w, time)
	write_uint(&w, key)
	write_uint(&w, state)
	end_message(&w)
}

// modifier and group state
wl_keyboard_send_modifiers :: proc(obj: ^Object, serial: u32, mods_depressed: u32, mods_latched: u32, mods_locked: u32, group: u32) {
	w := begin_message(obj, 4)
	write_uint(&w, serial)
	write_uint(&w, mods_depressed)
	write_uint(&w, mods_latched)
	write_uint(&w, mods_locked)
	write_uint(&w, group)
	end_message(&w)
}

// repeat rate and delay
wl_keyboard_send_repeat_info :: proc(obj: ^Object, rate: i32, delay: i32) {
	if obj.version < 4 { return }
	w := begin_message(obj, 5)
	write_int(&w, rate)
	write_int(&w, delay)
	end_message(&w)
}

// release the keyboard object
wl_keyboard_release :: proc(obj: ^Object) {
	if obj.version < 3 { return }
	w := begin_message(obj, 0)
	end_message(&w)
	object_destroy(obj)
}

// ===== wl_touch (version 11) =====
// touchscreen input device

wl_touch_interface := Interface{
	name = "wl_touch",
	version = 11,
	requests = {
		{name = "release", signature = "", since = 3, fd_count = 0, destructor = true},
	},
	events = {
		{name = "down", signature = "uuoiff", since = 1, fd_count = 0, destructor = false},
		{name = "up", signature = "uui", since = 1, fd_count = 0, destructor = false},
		{name = "motion", signature = "uiff", since = 1, fd_count = 0, destructor = false},
		{name = "frame", signature = "", since = 1, fd_count = 0, destructor = false},
		{name = "cancel", signature = "", since = 1, fd_count = 0, destructor = false},
		{name = "shape", signature = "iff", since = 6, fd_count = 0, destructor = false},
		{name = "orientation", signature = "if", since = 6, fd_count = 0, destructor = false},
	},
	dispatch_request = _wl_touch_dispatch_request,
	dispatch_event = _wl_touch_dispatch_event,
}

Wl_Touch_Request :: enum u16 {
	release = 0,
}

Wl_Touch_Event :: enum u16 {
	down = 0,
	up = 1,
	motion = 2,
	frame = 3,
	cancel = 4,
	shape = 5,
	orientation = 6,
}

// server-side request handlers
Wl_Touch_Requests :: struct {
	// release the touch object
	release: proc(obj: ^Object),
}

// client-side event handlers
Wl_Touch_Events :: struct {
	// touch down event and beginning of a touch sequence
	down: proc(obj: ^Object, serial: u32, time: u32, surface: ^Object, id: i32, x: Fixed, y: Fixed),
	// end of a touch event sequence
	up: proc(obj: ^Object, serial: u32, time: u32, id: i32),
	// update of touch point coordinates
	motion: proc(obj: ^Object, time: u32, id: i32, x: Fixed, y: Fixed),
	// end of touch frame event
	frame: proc(obj: ^Object),
	// touch session cancelled
	cancel: proc(obj: ^Object),
	// update shape of touch point
	shape: proc(obj: ^Object, id: i32, major: Fixed, minor: Fixed),
	// update orientation of touch point
	orientation: proc(obj: ^Object, id: i32, orientation: Fixed),
}

@(private)
_wl_touch_dispatch_request :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Touch_Requests)(obj.handlers)
	switch opcode {
	case 0: // release
		if !r.ok { return false }
		if h != nil && h.release != nil {
			h.release(obj)
		}
		object_destroy(obj)
	case:
		return false
	}
	return true
}

@(private)
_wl_touch_dispatch_event :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Touch_Events)(obj.handlers)
	switch opcode {
	case 0: // down
		a_serial := read_uint(r)
		a_time := read_uint(r)
		a_surface := read_object(r, &wl_surface_interface, false)
		a_id := read_int(r)
		a_x := read_fixed(r)
		a_y := read_fixed(r)
		if !r.ok { return false }
		if h != nil && h.down != nil {
			h.down(obj, a_serial, a_time, a_surface, a_id, a_x, a_y)
		}
	case 1: // up
		a_serial := read_uint(r)
		a_time := read_uint(r)
		a_id := read_int(r)
		if !r.ok { return false }
		if h != nil && h.up != nil {
			h.up(obj, a_serial, a_time, a_id)
		}
	case 2: // motion
		a_time := read_uint(r)
		a_id := read_int(r)
		a_x := read_fixed(r)
		a_y := read_fixed(r)
		if !r.ok { return false }
		if h != nil && h.motion != nil {
			h.motion(obj, a_time, a_id, a_x, a_y)
		}
	case 3: // frame
		if !r.ok { return false }
		if h != nil && h.frame != nil {
			h.frame(obj)
		}
	case 4: // cancel
		if !r.ok { return false }
		if h != nil && h.cancel != nil {
			h.cancel(obj)
		}
	case 5: // shape
		a_id := read_int(r)
		a_major := read_fixed(r)
		a_minor := read_fixed(r)
		if !r.ok { return false }
		if h != nil && h.shape != nil {
			h.shape(obj, a_id, a_major, a_minor)
		}
	case 6: // orientation
		a_id := read_int(r)
		a_orientation := read_fixed(r)
		if !r.ok { return false }
		if h != nil && h.orientation != nil {
			h.orientation(obj, a_id, a_orientation)
		}
	case:
		return false
	}
	return true
}

// touch down event and beginning of a touch sequence
wl_touch_send_down :: proc(obj: ^Object, serial: u32, time: u32, surface: ^Object, id: i32, x: Fixed, y: Fixed) {
	w := begin_message(obj, 0)
	write_uint(&w, serial)
	write_uint(&w, time)
	write_object(&w, surface)
	write_int(&w, id)
	write_fixed(&w, x)
	write_fixed(&w, y)
	end_message(&w)
}

// end of a touch event sequence
wl_touch_send_up :: proc(obj: ^Object, serial: u32, time: u32, id: i32) {
	w := begin_message(obj, 1)
	write_uint(&w, serial)
	write_uint(&w, time)
	write_int(&w, id)
	end_message(&w)
}

// update of touch point coordinates
wl_touch_send_motion :: proc(obj: ^Object, time: u32, id: i32, x: Fixed, y: Fixed) {
	w := begin_message(obj, 2)
	write_uint(&w, time)
	write_int(&w, id)
	write_fixed(&w, x)
	write_fixed(&w, y)
	end_message(&w)
}

// end of touch frame event
wl_touch_send_frame :: proc(obj: ^Object) {
	w := begin_message(obj, 3)
	end_message(&w)
}

// touch session cancelled
wl_touch_send_cancel :: proc(obj: ^Object) {
	w := begin_message(obj, 4)
	end_message(&w)
}

// update shape of touch point
wl_touch_send_shape :: proc(obj: ^Object, id: i32, major: Fixed, minor: Fixed) {
	if obj.version < 6 { return }
	w := begin_message(obj, 5)
	write_int(&w, id)
	write_fixed(&w, major)
	write_fixed(&w, minor)
	end_message(&w)
}

// update orientation of touch point
wl_touch_send_orientation :: proc(obj: ^Object, id: i32, orientation: Fixed) {
	if obj.version < 6 { return }
	w := begin_message(obj, 6)
	write_int(&w, id)
	write_fixed(&w, orientation)
	end_message(&w)
}

// release the touch object
wl_touch_release :: proc(obj: ^Object) {
	if obj.version < 3 { return }
	w := begin_message(obj, 0)
	end_message(&w)
	object_destroy(obj)
}

// ===== wl_output (version 4) =====
// compositor output region

wl_output_interface := Interface{
	name = "wl_output",
	version = 4,
	requests = {
		{name = "release", signature = "", since = 3, fd_count = 0, destructor = true},
	},
	events = {
		{name = "geometry", signature = "iiiiissi", since = 1, fd_count = 0, destructor = false},
		{name = "mode", signature = "uiii", since = 1, fd_count = 0, destructor = false},
		{name = "done", signature = "", since = 2, fd_count = 0, destructor = false},
		{name = "scale", signature = "i", since = 2, fd_count = 0, destructor = false},
		{name = "name", signature = "s", since = 4, fd_count = 0, destructor = false},
		{name = "description", signature = "s", since = 4, fd_count = 0, destructor = false},
	},
	dispatch_request = _wl_output_dispatch_request,
	dispatch_event = _wl_output_dispatch_event,
}

Wl_Output_Subpixel :: enum u32 {
	unknown = 0, // unknown geometry
	none = 1, // no geometry
	horizontal_rgb = 2, // horizontal RGB
	horizontal_bgr = 3, // horizontal BGR
	vertical_rgb = 4, // vertical RGB
	vertical_bgr = 5, // vertical BGR
}

Wl_Output_Transform :: enum u32 {
	normal = 0, // no transform
	_90 = 1, // 90 degrees counter-clockwise
	_180 = 2, // 180 degrees counter-clockwise
	_270 = 3, // 270 degrees counter-clockwise
	flipped = 4, // 180 degree flip around a vertical axis
	flipped_90 = 5, // flip and rotate 90 degrees counter-clockwise
	flipped_180 = 6, // flip and rotate 180 degrees counter-clockwise
	flipped_270 = 7, // flip and rotate 270 degrees counter-clockwise
}

Wl_Output_Mode :: enum u32 { // bitfield
	current = 0x1, // indicates this is the current mode
	preferred = 0x2, // indicates this is the preferred mode
}

Wl_Output_Request :: enum u16 {
	release = 0,
}

Wl_Output_Event :: enum u16 {
	geometry = 0,
	mode = 1,
	done = 2,
	scale = 3,
	name = 4,
	description = 5,
}

// server-side request handlers
Wl_Output_Requests :: struct {
	// release the output object
	release: proc(obj: ^Object),
}

// client-side event handlers
Wl_Output_Events :: struct {
	// properties of the output
	geometry: proc(obj: ^Object, x: i32, y: i32, physical_width: i32, physical_height: i32, subpixel: i32, make: string, model: string, transform: i32),
	// advertise available modes for the output
	mode: proc(obj: ^Object, flags: u32, width: i32, height: i32, refresh: i32),
	// sent all information about output
	done: proc(obj: ^Object),
	// output scaling properties
	scale: proc(obj: ^Object, factor: i32),
	// name of this output
	name: proc(obj: ^Object, name: string),
	// human-readable description of this output
	description: proc(obj: ^Object, description: string),
}

@(private)
_wl_output_dispatch_request :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Output_Requests)(obj.handlers)
	switch opcode {
	case 0: // release
		if !r.ok { return false }
		if h != nil && h.release != nil {
			h.release(obj)
		}
		object_destroy(obj)
	case:
		return false
	}
	return true
}

@(private)
_wl_output_dispatch_event :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Output_Events)(obj.handlers)
	switch opcode {
	case 0: // geometry
		a_x := read_int(r)
		a_y := read_int(r)
		a_physical_width := read_int(r)
		a_physical_height := read_int(r)
		a_subpixel := read_int(r)
		a_make := read_string(r, false)
		a_model := read_string(r, false)
		a_transform := read_int(r)
		if !r.ok { return false }
		if h != nil && h.geometry != nil {
			h.geometry(obj, a_x, a_y, a_physical_width, a_physical_height, a_subpixel, a_make, a_model, a_transform)
		}
	case 1: // mode
		a_flags := read_uint(r)
		a_width := read_int(r)
		a_height := read_int(r)
		a_refresh := read_int(r)
		if !r.ok { return false }
		if h != nil && h.mode != nil {
			h.mode(obj, a_flags, a_width, a_height, a_refresh)
		}
	case 2: // done
		if !r.ok { return false }
		if h != nil && h.done != nil {
			h.done(obj)
		}
	case 3: // scale
		a_factor := read_int(r)
		if !r.ok { return false }
		if h != nil && h.scale != nil {
			h.scale(obj, a_factor)
		}
	case 4: // name
		a_name := read_string(r, false)
		if !r.ok { return false }
		if h != nil && h.name != nil {
			h.name(obj, a_name)
		}
	case 5: // description
		a_description := read_string(r, false)
		if !r.ok { return false }
		if h != nil && h.description != nil {
			h.description(obj, a_description)
		}
	case:
		return false
	}
	return true
}

// properties of the output
wl_output_send_geometry :: proc(obj: ^Object, x: i32, y: i32, physical_width: i32, physical_height: i32, subpixel: i32, make: string, model: string, transform: i32) {
	w := begin_message(obj, 0)
	write_int(&w, x)
	write_int(&w, y)
	write_int(&w, physical_width)
	write_int(&w, physical_height)
	write_int(&w, subpixel)
	write_string(&w, make, false)
	write_string(&w, model, false)
	write_int(&w, transform)
	end_message(&w)
}

// advertise available modes for the output
wl_output_send_mode :: proc(obj: ^Object, flags: u32, width: i32, height: i32, refresh: i32) {
	w := begin_message(obj, 1)
	write_uint(&w, flags)
	write_int(&w, width)
	write_int(&w, height)
	write_int(&w, refresh)
	end_message(&w)
}

// sent all information about output
wl_output_send_done :: proc(obj: ^Object) {
	if obj.version < 2 { return }
	w := begin_message(obj, 2)
	end_message(&w)
}

// output scaling properties
wl_output_send_scale :: proc(obj: ^Object, factor: i32) {
	if obj.version < 2 { return }
	w := begin_message(obj, 3)
	write_int(&w, factor)
	end_message(&w)
}

// name of this output
wl_output_send_name :: proc(obj: ^Object, name: string) {
	if obj.version < 4 { return }
	w := begin_message(obj, 4)
	write_string(&w, name, false)
	end_message(&w)
}

// human-readable description of this output
wl_output_send_description :: proc(obj: ^Object, description: string) {
	if obj.version < 4 { return }
	w := begin_message(obj, 5)
	write_string(&w, description, false)
	end_message(&w)
}

// release the output object
wl_output_release :: proc(obj: ^Object) {
	if obj.version < 3 { return }
	w := begin_message(obj, 0)
	end_message(&w)
	object_destroy(obj)
}

// ===== wl_region (version 7) =====
// region interface

wl_region_interface := Interface{
	name = "wl_region",
	version = 7,
	requests = {
		{name = "destroy", signature = "", since = 1, fd_count = 0, destructor = true},
		{name = "add", signature = "iiii", since = 1, fd_count = 0, destructor = false},
		{name = "subtract", signature = "iiii", since = 1, fd_count = 0, destructor = false},
	},
	events = {
	},
	dispatch_request = _wl_region_dispatch_request,
	dispatch_event = _wl_region_dispatch_event,
}

Wl_Region_Request :: enum u16 {
	destroy = 0,
	add = 1,
	subtract = 2,
}

// server-side request handlers
Wl_Region_Requests :: struct {
	// destroy region
	destroy: proc(obj: ^Object),
	// add rectangle to region
	add: proc(obj: ^Object, x: i32, y: i32, width: i32, height: i32),
	// subtract rectangle from region
	subtract: proc(obj: ^Object, x: i32, y: i32, width: i32, height: i32),
}

// client-side event handlers
Wl_Region_Events :: struct {
}

@(private)
_wl_region_dispatch_request :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Region_Requests)(obj.handlers)
	switch opcode {
	case 0: // destroy
		if !r.ok { return false }
		if h != nil && h.destroy != nil {
			h.destroy(obj)
		}
		object_destroy(obj)
	case 1: // add
		a_x := read_int(r)
		a_y := read_int(r)
		a_width := read_int(r)
		a_height := read_int(r)
		if !r.ok { return false }
		if h != nil && h.add != nil {
			h.add(obj, a_x, a_y, a_width, a_height)
		}
	case 2: // subtract
		a_x := read_int(r)
		a_y := read_int(r)
		a_width := read_int(r)
		a_height := read_int(r)
		if !r.ok { return false }
		if h != nil && h.subtract != nil {
			h.subtract(obj, a_x, a_y, a_width, a_height)
		}
	case:
		return false
	}
	return true
}

@(private)
_wl_region_dispatch_event :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	return false
}

// destroy region
wl_region_destroy :: proc(obj: ^Object) {
	w := begin_message(obj, 0)
	end_message(&w)
	object_destroy(obj)
}

// add rectangle to region
wl_region_add :: proc(obj: ^Object, x: i32, y: i32, width: i32, height: i32) {
	w := begin_message(obj, 1)
	write_int(&w, x)
	write_int(&w, y)
	write_int(&w, width)
	write_int(&w, height)
	end_message(&w)
}

// subtract rectangle from region
wl_region_subtract :: proc(obj: ^Object, x: i32, y: i32, width: i32, height: i32) {
	w := begin_message(obj, 2)
	write_int(&w, x)
	write_int(&w, y)
	write_int(&w, width)
	write_int(&w, height)
	end_message(&w)
}

// ===== wl_subcompositor (version 1) =====
// sub-surface compositing

wl_subcompositor_interface := Interface{
	name = "wl_subcompositor",
	version = 1,
	requests = {
		{name = "destroy", signature = "", since = 1, fd_count = 0, destructor = true},
		{name = "get_subsurface", signature = "noo", since = 1, fd_count = 0, destructor = false},
	},
	events = {
	},
	dispatch_request = _wl_subcompositor_dispatch_request,
	dispatch_event = _wl_subcompositor_dispatch_event,
}

Wl_Subcompositor_Error :: enum u32 {
	bad_surface = 0, // the to-be sub-surface is invalid
	bad_parent = 1, // the to-be sub-surface parent is invalid
}

Wl_Subcompositor_Request :: enum u16 {
	destroy = 0,
	get_subsurface = 1,
}

// server-side request handlers
Wl_Subcompositor_Requests :: struct {
	// unbind from the subcompositor interface
	destroy: proc(obj: ^Object),
	// give a surface the role sub-surface
	get_subsurface: proc(obj: ^Object, id: ^Object, surface: ^Object, parent: ^Object),
}

// client-side event handlers
Wl_Subcompositor_Events :: struct {
}

@(private)
_wl_subcompositor_dispatch_request :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Subcompositor_Requests)(obj.handlers)
	switch opcode {
	case 0: // destroy
		if !r.ok { return false }
		if h != nil && h.destroy != nil {
			h.destroy(obj)
		}
		object_destroy(obj)
	case 1: // get_subsurface
		a_id := read_new_id(r, &wl_subsurface_interface, obj.version)
		a_surface := read_object(r, &wl_surface_interface, false)
		a_parent := read_object(r, &wl_surface_interface, false)
		if !r.ok { return false }
		if h != nil && h.get_subsurface != nil {
			h.get_subsurface(obj, a_id, a_surface, a_parent)
		}
	case:
		return false
	}
	return true
}

@(private)
_wl_subcompositor_dispatch_event :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	return false
}

// unbind from the subcompositor interface
wl_subcompositor_destroy :: proc(obj: ^Object) {
	w := begin_message(obj, 0)
	end_message(&w)
	object_destroy(obj)
}

// give a surface the role sub-surface
wl_subcompositor_get_subsurface :: proc(obj: ^Object, surface: ^Object, parent: ^Object) -> ^Object {
	id := object_create(obj.conn, &wl_subsurface_interface, obj.version)
	w := begin_message(obj, 1)
	write_object(&w, id)
	write_object(&w, surface)
	write_object(&w, parent)
	end_message(&w)
	return id
}

// ===== wl_subsurface (version 1) =====
// sub-surface interface to a wl_surface

wl_subsurface_interface := Interface{
	name = "wl_subsurface",
	version = 1,
	requests = {
		{name = "destroy", signature = "", since = 1, fd_count = 0, destructor = true},
		{name = "set_position", signature = "ii", since = 1, fd_count = 0, destructor = false},
		{name = "place_above", signature = "o", since = 1, fd_count = 0, destructor = false},
		{name = "place_below", signature = "o", since = 1, fd_count = 0, destructor = false},
		{name = "set_sync", signature = "", since = 1, fd_count = 0, destructor = false},
		{name = "set_desync", signature = "", since = 1, fd_count = 0, destructor = false},
	},
	events = {
	},
	dispatch_request = _wl_subsurface_dispatch_request,
	dispatch_event = _wl_subsurface_dispatch_event,
}

Wl_Subsurface_Error :: enum u32 {
	bad_surface = 0, // wl_surface is not a sibling or the parent
}

Wl_Subsurface_Request :: enum u16 {
	destroy = 0,
	set_position = 1,
	place_above = 2,
	place_below = 3,
	set_sync = 4,
	set_desync = 5,
}

// server-side request handlers
Wl_Subsurface_Requests :: struct {
	// remove sub-surface interface
	destroy: proc(obj: ^Object),
	// reposition the sub-surface
	set_position: proc(obj: ^Object, x: i32, y: i32),
	// restack the sub-surface
	place_above: proc(obj: ^Object, sibling: ^Object),
	// restack the sub-surface
	place_below: proc(obj: ^Object, sibling: ^Object),
	// set sub-surface to synchronized mode
	set_sync: proc(obj: ^Object),
	// set sub-surface to desynchronized mode
	set_desync: proc(obj: ^Object),
}

// client-side event handlers
Wl_Subsurface_Events :: struct {
}

@(private)
_wl_subsurface_dispatch_request :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Subsurface_Requests)(obj.handlers)
	switch opcode {
	case 0: // destroy
		if !r.ok { return false }
		if h != nil && h.destroy != nil {
			h.destroy(obj)
		}
		object_destroy(obj)
	case 1: // set_position
		a_x := read_int(r)
		a_y := read_int(r)
		if !r.ok { return false }
		if h != nil && h.set_position != nil {
			h.set_position(obj, a_x, a_y)
		}
	case 2: // place_above
		a_sibling := read_object(r, &wl_surface_interface, false)
		if !r.ok { return false }
		if h != nil && h.place_above != nil {
			h.place_above(obj, a_sibling)
		}
	case 3: // place_below
		a_sibling := read_object(r, &wl_surface_interface, false)
		if !r.ok { return false }
		if h != nil && h.place_below != nil {
			h.place_below(obj, a_sibling)
		}
	case 4: // set_sync
		if !r.ok { return false }
		if h != nil && h.set_sync != nil {
			h.set_sync(obj)
		}
	case 5: // set_desync
		if !r.ok { return false }
		if h != nil && h.set_desync != nil {
			h.set_desync(obj)
		}
	case:
		return false
	}
	return true
}

@(private)
_wl_subsurface_dispatch_event :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	return false
}

// remove sub-surface interface
wl_subsurface_destroy :: proc(obj: ^Object) {
	w := begin_message(obj, 0)
	end_message(&w)
	object_destroy(obj)
}

// reposition the sub-surface
wl_subsurface_set_position :: proc(obj: ^Object, x: i32, y: i32) {
	w := begin_message(obj, 1)
	write_int(&w, x)
	write_int(&w, y)
	end_message(&w)
}

// restack the sub-surface
wl_subsurface_place_above :: proc(obj: ^Object, sibling: ^Object) {
	w := begin_message(obj, 2)
	write_object(&w, sibling)
	end_message(&w)
}

// restack the sub-surface
wl_subsurface_place_below :: proc(obj: ^Object, sibling: ^Object) {
	w := begin_message(obj, 3)
	write_object(&w, sibling)
	end_message(&w)
}

// set sub-surface to synchronized mode
wl_subsurface_set_sync :: proc(obj: ^Object) {
	w := begin_message(obj, 4)
	end_message(&w)
}

// set sub-surface to desynchronized mode
wl_subsurface_set_desync :: proc(obj: ^Object) {
	w := begin_message(obj, 5)
	end_message(&w)
}

// ===== wl_fixes (version 2) =====
// wayland protocol fixes

wl_fixes_interface := Interface{
	name = "wl_fixes",
	version = 2,
	requests = {
		{name = "destroy", signature = "", since = 1, fd_count = 0, destructor = true},
		{name = "destroy_registry", signature = "o", since = 1, fd_count = 0, destructor = false},
		{name = "ack_global_remove", signature = "ou", since = 2, fd_count = 0, destructor = false},
	},
	events = {
	},
	dispatch_request = _wl_fixes_dispatch_request,
	dispatch_event = _wl_fixes_dispatch_event,
}

Wl_Fixes_Error :: enum u32 {
	invalid_ack_remove = 0, // unknown global or the global is not removed
}

Wl_Fixes_Request :: enum u16 {
	destroy = 0,
	destroy_registry = 1,
	ack_global_remove = 2,
}

// server-side request handlers
Wl_Fixes_Requests :: struct {
	// destroys this object
	destroy: proc(obj: ^Object),
	// destroy a wl_registry
	destroy_registry: proc(obj: ^Object, registry: ^Object),
	// acknowledge global removal
	ack_global_remove: proc(obj: ^Object, registry: ^Object, name: u32),
}

// client-side event handlers
Wl_Fixes_Events :: struct {
}

@(private)
_wl_fixes_dispatch_request :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Wl_Fixes_Requests)(obj.handlers)
	switch opcode {
	case 0: // destroy
		if !r.ok { return false }
		if h != nil && h.destroy != nil {
			h.destroy(obj)
		}
		object_destroy(obj)
	case 1: // destroy_registry
		a_registry := read_object(r, &wl_registry_interface, false)
		if !r.ok { return false }
		if h != nil && h.destroy_registry != nil {
			h.destroy_registry(obj, a_registry)
		}
	case 2: // ack_global_remove
		a_registry := read_object(r, &wl_registry_interface, false)
		a_name := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.ack_global_remove != nil {
			h.ack_global_remove(obj, a_registry, a_name)
		}
	case:
		return false
	}
	return true
}

@(private)
_wl_fixes_dispatch_event :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	return false
}

// destroys this object
wl_fixes_destroy :: proc(obj: ^Object) {
	w := begin_message(obj, 0)
	end_message(&w)
	object_destroy(obj)
}

// destroy a wl_registry
wl_fixes_destroy_registry :: proc(obj: ^Object, registry: ^Object) {
	w := begin_message(obj, 1)
	write_object(&w, registry)
	end_message(&w)
}

// acknowledge global removal
wl_fixes_ack_global_remove :: proc(obj: ^Object, registry: ^Object, name: u32) {
	if obj.version < 2 { return }
	w := begin_message(obj, 2)
	write_object(&w, registry)
	write_uint(&w, name)
	end_message(&w)
}

