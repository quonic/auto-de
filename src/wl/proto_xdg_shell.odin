	destroy = 0,
	set_parent = 1,
	set_title = 2,
	set_app_id = 3,
	show_window_menu = 4,
	move = 5,
	resize = 6,
	set_max_size = 7,
	set_min_size = 8,
	set_maximized = 9,
	unset_maximized = 10,
	set_fullscreen = 11,
	unset_fullscreen = 12,
	set_minimized = 13,
}

Xdg_Toplevel_Event :: enum u16 {
	configure = 0,
	close = 1,
	configure_bounds = 2,
	wm_capabilities = 3,
}

// server-side request handlers
Xdg_Toplevel_Requests :: struct {
	// destroy the xdg_toplevel
	destroy: proc(obj: ^Object),
	// set the parent of this surface
	set_parent: proc(obj: ^Object, parent: ^Object),
	// set surface title
	set_title: proc(obj: ^Object, title: string),
	// set application ID
	set_app_id: proc(obj: ^Object, app_id: string),
	// show the window menu
	show_window_menu: proc(obj: ^Object, seat: ^Object, serial: u32, x: i32, y: i32),
	// start an interactive move
	move: proc(obj: ^Object, seat: ^Object, serial: u32),
	// start an interactive resize
	resize: proc(obj: ^Object, seat: ^Object, serial: u32, edges: u32),
	// set the maximum size
	set_max_size: proc(obj: ^Object, width: i32, height: i32),
	// set the minimum size
	set_min_size: proc(obj: ^Object, width: i32, height: i32),
	// maximize the window
	set_maximized: proc(obj: ^Object),
	// unmaximize the window
	unset_maximized: proc(obj: ^Object),
	// set the window as fullscreen on an output
	set_fullscreen: proc(obj: ^Object, output: ^Object),
	// unset the window as fullscreen
	unset_fullscreen: proc(obj: ^Object),
	// set the window as minimized
	set_minimized: proc(obj: ^Object),
}

// client-side event handlers
Xdg_Toplevel_Events :: struct {
	// suggest a surface change
	configure: proc(obj: ^Object, width: i32, height: i32, states: []u8),
	// surface wants to be closed
	close: proc(obj: ^Object),
	// recommended window geometry bounds
	configure_bounds: proc(obj: ^Object, width: i32, height: i32),
	// compositor capabilities
	wm_capabilities: proc(obj: ^Object, capabilities: []u8),
}

@(private)
_xdg_toplevel_dispatch_request :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Xdg_Toplevel_Requests)(obj.handlers)
	switch opcode {
	case 0: // destroy
		if !r.ok { return false }
		if h != nil && h.destroy != nil {
			h.destroy(obj)
		}
		object_destroy(obj)
	case 1: // set_parent
		a_parent := read_object(r, &xdg_toplevel_interface, true)
		if !r.ok { return false }
		if h != nil && h.set_parent != nil {
			h.set_parent(obj, a_parent)
		}
	case 2: // set_title
		a_title := read_string(r, false)
		if !r.ok { return false }
		if h != nil && h.set_title != nil {
			h.set_title(obj, a_title)
		}
	case 3: // set_app_id
		a_app_id := read_string(r, false)
		if !r.ok { return false }
		if h != nil && h.set_app_id != nil {
			h.set_app_id(obj, a_app_id)
		}
	case 4: // show_window_menu
		a_seat := read_object(r, &wl_seat_interface, false)
		a_serial := read_uint(r)
		a_x := read_int(r)
		a_y := read_int(r)
		if !r.ok { return false }
		if h != nil && h.show_window_menu != nil {
			h.show_window_menu(obj, a_seat, a_serial, a_x, a_y)
		}
	case 5: // move
		a_seat := read_object(r, &wl_seat_interface, false)
		a_serial := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.move != nil {
			h.move(obj, a_seat, a_serial)
		}
	case 6: // resize
		a_seat := read_object(r, &wl_seat_interface, false)
		a_serial := read_uint(r)
		a_edges := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.resize != nil {
			h.resize(obj, a_seat, a_serial, a_edges)
		}
	case 7: // set_max_size
		a_width := read_int(r)
		a_height := read_int(r)
		if !r.ok { return false }
		if h != nil && h.set_max_size != nil {
			h.set_max_size(obj, a_width, a_height)
		}
	case 8: // set_min_size
		a_width := read_int(r)
		a_height := read_int(r)
		if !r.ok { return false }
		if h != nil && h.set_min_size != nil {
			h.set_min_size(obj, a_width, a_height)
		}
	case 9: // set_maximized
		if !r.ok { return false }
		if h != nil && h.set_maximized != nil {
			h.set_maximized(obj)
		}
	case 10: // unset_maximized
		if !r.ok { return false }
		if h != nil && h.unset_maximized != nil {
			h.unset_maximized(obj)
		}
	case 11: // set_fullscreen
		a_output := read_object(r, &wl_output_interface, true)
		if !r.ok { return false }
		if h != nil && h.set_fullscreen != nil {
			h.set_fullscreen(obj, a_output)
		}
	case 12: // unset_fullscreen
		if !r.ok { return false }
		if h != nil && h.unset_fullscreen != nil {
			h.unset_fullscreen(obj)
		}
	case 13: // set_minimized
		if !r.ok { return false }
		if h != nil && h.set_minimized != nil {
			h.set_minimized(obj)
		}
	case:
		return false
	}
	return true
}

@(private)
_xdg_toplevel_dispatch_event :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Xdg_Toplevel_Events)(obj.handlers)
	switch opcode {
	case 0: // configure
		a_width := read_int(r)
		a_height := read_int(r)
		a_states := read_array(r)
		if !r.ok { return false }
		if h != nil && h.configure != nil {
			h.configure(obj, a_width, a_height, a_states)
		}
	case 1: // close
		if !r.ok { return false }
		if h != nil && h.close != nil {
			h.close(obj)
		}
	case 2: // configure_bounds
		a_width := read_int(r)
		a_height := read_int(r)
		if !r.ok { return false }
		if h != nil && h.configure_bounds != nil {
			h.configure_bounds(obj, a_width, a_height)
		}
	case 3: // wm_capabilities
		a_capabilities := read_array(r)
		if !r.ok { return false }
		if h != nil && h.wm_capabilities != nil {
			h.wm_capabilities(obj, a_capabilities)
		}
	case:
		return false
	}
	return true
}

// suggest a surface change
xdg_toplevel_send_configure :: proc(obj: ^Object, width: i32, height: i32, states: []u8) {
	w := begin_message(obj, 0)
	write_int(&w, width)
	write_int(&w, height)
	write_array(&w, states)
	end_message(&w)
}

// surface wants to be closed
xdg_toplevel_send_close :: proc(obj: ^Object) {
	w := begin_message(obj, 1)
	end_message(&w)
}

// recommended window geometry bounds
xdg_toplevel_send_configure_bounds :: proc(obj: ^Object, width: i32, height: i32) {
	if obj.version < 4 { return }
	w := begin_message(obj, 2)
	write_int(&w, width)
	write_int(&w, height)
	end_message(&w)
}

// compositor capabilities
xdg_toplevel_send_wm_capabilities :: proc(obj: ^Object, capabilities: []u8) {
	if obj.version < 5 { return }
	w := begin_message(obj, 3)
	write_array(&w, capabilities)
	end_message(&w)
}

// destroy the xdg_toplevel
xdg_toplevel_destroy :: proc(obj: ^Object) {
	w := begin_message(obj, 0)
	end_message(&w)
	object_destroy(obj)
}

// set the parent of this surface
xdg_toplevel_set_parent :: proc(obj: ^Object, parent: ^Object) {
	w := begin_message(obj, 1)
	write_object(&w, parent)
	end_message(&w)
}

// set surface title
xdg_toplevel_set_title :: proc(obj: ^Object, title: string) {
	w := begin_message(obj, 2)
	write_string(&w, title, false)
	end_message(&w)
}

// set application ID
xdg_toplevel_set_app_id :: proc(obj: ^Object, app_id: string) {
	w := begin_message(obj, 3)
	write_string(&w, app_id, false)
	end_message(&w)
}

// show the window menu
xdg_toplevel_show_window_menu :: proc(obj: ^Object, seat: ^Object, serial: u32, x: i32, y: i32) {
	w := begin_message(obj, 4)
	write_object(&w, seat)
	write_uint(&w, serial)
	write_int(&w, x)
	write_int(&w, y)
	end_message(&w)
}

// start an interactive move
xdg_toplevel_move :: proc(obj: ^Object, seat: ^Object, serial: u32) {
	w := begin_message(obj, 5)
	write_object(&w, seat)
	write_uint(&w, serial)
	end_message(&w)
}

// start an interactive resize
xdg_toplevel_resize :: proc(obj: ^Object, seat: ^Object, serial: u32, edges: u32) {
	w := begin_message(obj, 6)
	write_object(&w, seat)
	write_uint(&w, serial)
	write_uint(&w, edges)
	end_message(&w)
}

// set the maximum size
xdg_toplevel_set_max_size :: proc(obj: ^Object, width: i32, height: i32) {
	w := begin_message(obj, 7)
	write_int(&w, width)
	write_int(&w, height)
	end_message(&w)
}

// set the minimum size
xdg_toplevel_set_min_size :: proc(obj: ^Object, width: i32, height: i32) {
	w := begin_message(obj, 8)
	write_int(&w, width)
	write_int(&w, height)
	end_message(&w)
}

// maximize the window
xdg_toplevel_set_maximized :: proc(obj: ^Object) {
	w := begin_message(obj, 9)
	end_message(&w)
}

// unmaximize the window
xdg_toplevel_unset_maximized :: proc(obj: ^Object) {
	w := begin_message(obj, 10)
	end_message(&w)
}

// set the window as fullscreen on an output
xdg_toplevel_set_fullscreen :: proc(obj: ^Object, output: ^Object) {
	w := begin_message(obj, 11)
	write_object(&w, output)
	end_message(&w)
}

// unset the window as fullscreen
xdg_toplevel_unset_fullscreen :: proc(obj: ^Object) {
	w := begin_message(obj, 12)
	end_message(&w)
}

// set the window as minimized
xdg_toplevel_set_minimized :: proc(obj: ^Object) {
	w := begin_message(obj, 13)
	end_message(&w)
}

// ===== xdg_popup (version 7) =====
// short-lived, popup surfaces for menus

xdg_popup_interface := Interface{
	name = "xdg_popup",
	version = 7,
	requests = {
		{name = "destroy", signature = "", since = 1, fd_count = 0, destructor = true},
		{name = "grab", signature = "ou", since = 1, fd_count = 0, destructor = false},
		{name = "reposition", signature = "ou", since = 3, fd_count = 0, destructor = false},
	},
	events = {
		{name = "configure", signature = "iiii", since = 1, fd_count = 0, destructor = false},
		{name = "popup_done", signature = "", since = 1, fd_count = 0, destructor = false},
		{name = "repositioned", signature = "u", since = 3, fd_count = 0, destructor = false},
	},
	dispatch_request = _xdg_popup_dispatch_request,
	dispatch_event = _xdg_popup_dispatch_event,
}

Xdg_Popup_Error :: enum u32 {
	invalid_grab = 0, // tried to grab after being mapped
}

Xdg_Popup_Request :: enum u16 {
	destroy = 0,
	grab = 1,
	reposition = 2,
}

Xdg_Popup_Event :: enum u16 {
	configure = 0,
	popup_done = 1,
	repositioned = 2,
}

// server-side request handlers
Xdg_Popup_Requests :: struct {
	// remove xdg_popup interface
	destroy: proc(obj: ^Object),
	// make the popup take an explicit grab
	grab: proc(obj: ^Object, seat: ^Object, serial: u32),
	// recalculate the popup's location
	reposition: proc(obj: ^Object, positioner: ^Object, token: u32),
}

// client-side event handlers
Xdg_Popup_Events :: struct {
	// configure the popup surface
	configure: proc(obj: ^Object, x: i32, y: i32, width: i32, height: i32),
	// popup interaction is done
	popup_done: proc(obj: ^Object),
	// signal the completion of a repositioned request
	repositioned: proc(obj: ^Object, token: u32),
}

@(private)
_xdg_popup_dispatch_request :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Xdg_Popup_Requests)(obj.handlers)
	switch opcode {
	case 0: // destroy
		if !r.ok { return false }
		if h != nil && h.destroy != nil {
			h.destroy(obj)
		}
		object_destroy(obj)
	case 1: // grab
		a_seat := read_object(r, &wl_seat_interface, false)
		a_serial := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.grab != nil {
			h.grab(obj, a_seat, a_serial)
		}
	case 2: // reposition
		a_positioner := read_object(r, &xdg_positioner_interface, false)
		a_token := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.reposition != nil {
			h.reposition(obj, a_positioner, a_token)
		}
	case:
		return false
	}
	return true
}

@(private)
_xdg_popup_dispatch_event :: proc(obj: ^Object, opcode: u16, r: ^Reader) -> bool {
	h := (^Xdg_Popup_Events)(obj.handlers)
	switch opcode {
	case 0: // configure
		a_x := read_int(r)
		a_y := read_int(r)
		a_width := read_int(r)
		a_height := read_int(r)
		if !r.ok { return false }
		if h != nil && h.configure != nil {
			h.configure(obj, a_x, a_y, a_width, a_height)
		}
	case 1: // popup_done
		if !r.ok { return false }
		if h != nil && h.popup_done != nil {
			h.popup_done(obj)
		}
	case 2: // repositioned
		a_token := read_uint(r)
		if !r.ok { return false }
		if h != nil && h.repositioned != nil {
			h.repositioned(obj, a_token)
		}
	case:
		return false
	}
	return true
}

// configure the popup surface
xdg_popup_send_configure :: proc(obj: ^Object, x: i32, y: i32, width: i32, height: i32) {
	w := begin_message(obj, 0)
	write_int(&w, x)
	write_int(&w, y)
	write_int(&w, width)
	write_int(&w, height)
	end_message(&w)
}

// popup interaction is done
xdg_popup_send_popup_done :: proc(obj: ^Object) {
	w := begin_message(obj, 1)
	end_message(&w)
}

// signal the completion of a repositioned request
xdg_popup_send_repositioned :: proc(obj: ^Object, token: u32) {
	if obj.version < 3 { return }
	w := begin_message(obj, 2)
	write_uint(&w, token)
	end_message(&w)
}

// remove xdg_popup interface
xdg_popup_destroy :: proc(obj: ^Object) {
	w := begin_message(obj, 0)
	end_message(&w)
	object_destroy(obj)
}

// make the popup take an explicit grab
xdg_popup_grab :: proc(obj: ^Object, seat: ^Object, serial: u32) {
	w := begin_message(obj, 1)
	write_object(&w, seat)
	write_uint(&w, serial)
	end_message(&w)
}

// recalculate the popup's location
xdg_popup_reposition :: proc(obj: ^Object, positioner: ^Object, token: u32) {
	if obj.version < 3 { return }
	w := begin_message(obj, 2)
	write_object(&w, positioner)
	write_uint(&w, token)
	end_message(&w)
}

